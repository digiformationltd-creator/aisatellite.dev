# Global Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https: https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';

# Cache-Control for immutable static hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-Control for search indexes
/pagefind/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Cache-Control for images and fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=86400

# Private & Authenticated Routes - NEVER cache in shared public caches
/workspace*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/api/*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/operations-admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/growth-admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/research-admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/reliability-admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/launch-admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache

/admin*
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache
