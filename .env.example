# ==============================================================================
# AI SATELLITE — PRODUCTION ENVIRONMENT CONFIGURATION
# Permanent Production Domain: https://aisatellite.dev
# ==============================================================================

# Core Domain & Canonical Identity
SITE_URL=https://aisatellite.dev
CANONICAL_ORIGIN=https://aisatellite.dev
PUBLIC_SITE_NAME="AI Satellite"
PUBLIC_SITE_DESCRIPTION="Explore free alternatives, AI tools, open-source software, developer prompts and practical technology solutions."

# Deployment Environment ('production' | 'staging' | 'preview' | 'development')
DEPLOYMENT_ENVIRONMENT=production
NODE_ENV=production

# Cloudflare Infrastructure
CLOUDFLARE_PAGES_PROJECT=aisatellite
CUSTOM_DOMAIN_VERIFIED=true

# Security & Sessions
SESSION_SECRET=replace_with_secure_64_character_hex_secret_in_production
CSRF_SECRET=replace_with_secure_random_csrf_secret

# Reliability & Quotas
ALERT_WEBHOOK_URL=""
INDEXNOW_KEY=""
INDEXNOW_KEY_LOCATION=https://aisatellite.dev/indexnow-key.txt
D1_DATABASE_ID=""
R2_BUCKET_NAME=""
