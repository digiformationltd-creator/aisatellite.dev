{
  "name": "ai-satellite",
  "version": "1.0.0",
  "description": "AI Satellite - The Global Open-Source & Autonomous AI Knowledge Station",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "wrangler pages deploy dist --project-name aisatellite --branch main"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "pagefind": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "three": "^0.174.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
