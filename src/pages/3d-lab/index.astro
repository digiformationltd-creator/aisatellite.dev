---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import DemoViewer from '@/components/lab/DemoViewer.tsx';
import Badge from '@/components/ui/Badge.astro';
import { Sparkles, ArrowRight, Code } from 'lucide-react';

const labDemos = await getCollection('lab', ({ data }) => data.published);
---

<BaseLayout
  title="3D Web Lab — Three.js, WebGL & GLSL Shaders"
  description="High-performance, GPU-optimized 3D web canvases, liquid shaders, and glassmorphic UI components."
>
  <PageContainer class="py-10">
    <Breadcrumbs items={[{ label: '3D Web Lab' }]} />

    <SectionHeading
      badge="Creative Engineering"
      title="3D Web Lab & Creative Canvas"
      description="Interactive, hardware-accelerated WebGL components and Three.js presets engineered for 60fps performance and zero memory leaks."
    />

    <!-- Main Interactive Demo Island -->
    <div class="my-8 max-w-4xl mx-auto">
      <DemoViewer client:visible />
    </div>

    <!-- Additional Demos Grid -->
    <div class="mt-16">
      <h2 class="text-xl font-heading font-bold text-text-primary mb-6 flex items-center gap-2">
        <Sparkles className="w-5 h-5 text-cosmic-cyan" />
        <span>3D Lab Architectural Showcase</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          labDemos.map((demo) => (
            <div class="cosmic-glass p-6 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <Badge variant="emerald" size="sm">{demo.data.demoType}</Badge>
                  <span class="text-xs font-mono text-text-muted">{demo.data.status}</span>
                </div>

                <h3 class="text-lg font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
                  <a href={`/3d-lab/${demo.id}`}>{demo.data.title}</a>
                </h3>

                <p class="text-sm text-text-secondary leading-relaxed mb-4">
                  {demo.data.description}
                </p>

                <div class="flex flex-wrap gap-1 mb-4">
                  {demo.data.tech.map((t) => (
                    <span class="px-2 py-0.5 text-xs font-mono rounded bg-space-950 text-text-muted border border-border-subtle">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
                <a
                  href={`/3d-lab/${demo.id}`}
                  class="text-xs font-semibold text-cosmic-cyan hover:underline inline-flex items-center gap-1"
                >
                  <span>Inspect Code & Demo</span>
                  <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </PageContainer>
</BaseLayout>
