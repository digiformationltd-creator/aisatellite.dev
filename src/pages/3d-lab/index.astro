---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import AdvancedLabViewer from '@/components/lab/AdvancedLabViewer.tsx';
import Badge from '@/components/ui/Badge.astro';
import { LAB_CATEGORIES } from '@/data/lab-categories';
import { Sparkles, ArrowRight, Code, Zap, Layers, Cpu, ShieldCheck } from 'lucide-react';

const labDemos = await getCollection('lab', ({ data }) => data.published);
---

<BaseLayout
  title="3D Web Lab & Creative Canvas — Production Three.js & GLSL Demos"
  description="Explore production-grade 3D web canvases, GLSL fluid shaders, interactive product configurators, and perspective tilt cards with copyable source code and AI prompts."
>
  <PageContainer class="py-10">
    <Breadcrumbs items={[{ label: '3D Web Lab' }]} />

    <SectionHeading
      badge="Creative Three.js & WebGL Engineering"
      title="3D Web Lab & Interactive Canvas Engine"
      description="Hardware-accelerated Three.js components, liquid GLSL shaders, and CSS 3D systems engineered for sustained 60fps performance and guaranteed zero WebGL context leaks."
    />

    <!-- Quick Category Badges -->
    <div class="flex items-center gap-2 flex-wrap justify-center my-6">
      <a
        href="/3d-lab"
        class="px-3 py-1.5 rounded-full text-xs font-mono bg-cosmic-cyan text-space-950 font-bold shadow-glow-cyan/20"
      >
        All Flags ({labDemos.length})
      </a>
      {LAB_CATEGORIES.map((cat) => (
        <a
          href={`/3d-lab/category/${cat.slug}`}
          class="px-3 py-1.5 rounded-full text-xs font-mono bg-space-900 hover:bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle transition-colors"
        >
          {cat.name}
        </a>
      ))}
      <a
        href="/3d-lab/prompts"
        class="px-3 py-1.5 rounded-full text-xs font-mono bg-cosmic-violet/10 text-cosmic-violet border border-cosmic-violet/30 hover:bg-cosmic-violet/20 transition-colors flex items-center gap-1"
      >
        <Sparkles className="w-3.5 h-3.5" />
        <span>Prompt Vault</span>
      </a>
    </div>

    <!-- Master Interactive Lab Viewer Island -->
    <div class="my-8 max-w-5xl mx-auto">
      <AdvancedLabViewer client:visible />
    </div>

    <!-- Hardware Specifications Banner -->
    <div class="max-w-5xl mx-auto my-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
      <div class="cosmic-glass p-4 rounded-xl border border-border-subtle flex items-start gap-3">
        <Zap className="w-5 h-5 text-cosmic-emerald shrink-0 mt-0.5" />
        <div>
          <h4 class="text-xs font-bold font-mono text-text-primary">60 FPS Guaranteed</h4>
          <p class="text-[11px] text-text-muted mt-0.5">Optimized draw call batching and vertex buffers.</p>
        </div>
      </div>

      <div class="cosmic-glass p-4 rounded-xl border border-border-subtle flex items-start gap-3">
        <ShieldCheck className="w-5 h-5 text-cosmic-cyan shrink-0 mt-0.5" />
        <div>
          <h4 class="text-xs font-bold font-mono text-text-primary">Zero Context Leaks</h4>
          <p class="text-[11px] text-text-muted mt-0.5">Strict disposal routines on all WebGL renderers.</p>
        </div>
      </div>

      <div class="cosmic-glass p-4 rounded-xl border border-border-subtle flex items-start gap-3">
        <Layers className="w-5 h-5 text-cosmic-violet shrink-0 mt-0.5" />
        <div>
          <h4 class="text-xs font-bold font-mono text-text-primary">Copyable AI Prompts</h4>
          <p class="text-[11px] text-text-muted mt-0.5">Customizable variables for Cursor, Claude & Gemini.</p>
        </div>
      </div>

      <div class="cosmic-glass p-4 rounded-xl border border-border-subtle flex items-start gap-3">
        <Cpu className="w-5 h-5 text-cosmic-emerald shrink-0 mt-0.5" />
        <div>
          <h4 class="text-xs font-bold font-mono text-text-primary">Accessible Motion</h4>
          <p class="text-[11px] text-text-muted mt-0.5">prefers-reduced-motion triggers serene static states.</p>
        </div>
      </div>
    </div>

    <!-- Flagship Components Showcase Grid -->
    <div class="mt-16 max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-heading font-bold text-text-primary flex items-center gap-2">
            <Sparkles className="w-6 h-6 text-cosmic-cyan" />
            <span>Interactive 3D Components Catalog</span>
          </h2>
          <p class="text-sm text-text-secondary mt-1">
            Production-ready components for web applications, technical portfolios, and AI landing pages.
          </p>
        </div>
        <span class="text-xs font-mono text-text-muted hidden sm:inline">
          {labDemos.length} Verified Presets
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {labDemos.map((demo) => (
          <div class="cosmic-glass p-6 flex flex-col justify-between group border border-border-subtle hover:border-cosmic-cyan/40 transition-all rounded-card">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <Badge variant="cyan" size="sm">{demo.data.category}</Badge>
                <span class="text-[11px] font-mono text-cosmic-emerald flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-cosmic-emerald animate-pulse"></span>
                  <span>{demo.data.status}</span>
                </span>
              </div>

              <h3 class="text-lg font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
                <a href={`/3d-lab/${demo.id}`}>{demo.data.title}</a>
              </h3>

              <p class="text-xs text-text-secondary leading-relaxed mb-4 line-clamp-3">
                {demo.data.description}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {demo.data.tech.map((t) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-space-950 text-text-muted border border-border-subtle">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
              <span class="text-[11px] font-mono text-text-muted">{demo.data.license} License</span>
              <a
                href={`/3d-lab/${demo.id}`}
                class="text-xs font-semibold text-cosmic-cyan hover:underline inline-flex items-center gap-1"
              >
                <span>Live Demo &amp; Code</span>
                <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </PageContainer>
</BaseLayout>
