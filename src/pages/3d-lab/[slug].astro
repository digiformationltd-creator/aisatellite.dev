---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import AdvancedLabViewer from '@/components/lab/AdvancedLabViewer.tsx';
import { Terminal, ShieldCheck, Zap, Activity, Cpu, Code2, ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  const demos = await getCollection('lab', ({ data }) => data.published);
  return demos.map((demo) => ({
    params: { slug: demo.id },
    props: { demo },
  }));
}

const { demo } = Astro.props;
const { Content } = await render(demo);
const {
  title,
  category,
  description,
  tech,
  status,
  features,
  controls,
  installation,
  performanceNotes,
  reducedMotionNotes,
  license,
} = demo.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  operatingSystem: 'WebGL-compatible browsers',
  applicationCategory: 'MultimediaApplication',
  programmingLanguage: tech.join(', '),
  author: {
    '@type': 'Organization',
    name: 'AI Satellite Labs',
    url: 'https://aisatellite.pages.dev',
  },
  license: 'https://opensource.org/licenses/MIT',
};
---

<BaseLayout
  title={`${title} — 3D Web Lab & Source Code`}
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageContainer class="py-10 max-w-5xl">
    <Breadcrumbs
      items={[
        { label: '3D Web Lab', href: '/3d-lab' },
        { label: title },
      ]}
    />

    <!-- Header Section -->
    <header class="mt-6 pb-6 border-b border-border-subtle">
      <div class="flex items-center gap-2 mb-3">
        <Badge variant="cyan">{category}</Badge>
        <span class="text-xs font-mono text-cosmic-emerald px-2 py-0.5 rounded bg-space-900 border border-border-subtle flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-cosmic-emerald animate-pulse"></span>
          <span>{status}</span>
        </span>
        <span class="text-xs font-mono text-text-muted px-2 py-0.5 rounded bg-space-950 border border-border-subtle">
          {license} License
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-text-primary tracking-tight">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-text-secondary leading-relaxed">
        {description}
      </p>

      <div class="mt-4 flex flex-wrap gap-2">
        {tech.map((t) => (
          <span class="px-2.5 py-1 text-xs font-mono rounded bg-space-900 text-text-muted border border-border-subtle">
            {t}
          </span>
        ))}
      </div>
    </header>

    <!-- Master Interactive Lab Island focused on this demo -->
    <section class="my-8">
      <AdvancedLabViewer client:visible initialDemoId={demo.id} showAllTabs={false} />
    </section>

    <!-- Technical Specs & Controls Grid -->
    <div class="my-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Features List */}
      <div class="cosmic-glass p-6 rounded-card border border-border-subtle">
        <h3 class="text-base font-heading font-bold text-text-primary mb-4 flex items-center gap-2">
          <Zap className="w-4 h-4 text-cosmic-cyan" />
          <span>Key Capabilities &amp; Architecture</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-text-secondary">
          {features && features.length > 0 ? (
            features.map((feat) => (
              <li class="flex items-start gap-2">
                <span class="text-cosmic-cyan font-bold">&check;</span>
                <span>{feat}</span>
              </li>
            ))
          ) : (
            <li class="text-text-muted">Optimized GPU vertex processing and modular code structure.</li>
          )}
        </ul>
      </div>

      {/* Interactive Controls */}
      <div class="cosmic-glass p-6 rounded-card border border-border-subtle">
        <h3 class="text-base font-heading font-bold text-text-primary mb-4 flex items-center gap-2">
          <Activity className="w-4 h-4 text-cosmic-emerald" />
          <span>Interactive Controls &amp; Input</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-text-secondary">
          {controls && controls.length > 0 ? (
            controls.map((ctrl) => (
              <li class="flex items-start gap-2">
                <span class="text-cosmic-emerald font-bold">&bull;</span>
                <span>{ctrl}</span>
              </li>
            ))
          ) : (
            <li class="text-text-muted">Hardware pointer tracking and interactive viewport sizing.</li>
          )}
        </ul>
      </div>
    </div>

    <!-- Performance & Accessibility Notes -->
    <div class="my-8 cosmic-glass p-6 rounded-card border border-border-subtle space-y-4">
      <div class="flex items-start gap-3">
        <Cpu className="w-5 h-5 text-cosmic-cyan shrink-0 mt-0.5" />
        <div>
          <h4 class="text-sm font-heading font-bold text-text-primary">Performance Profile</h4>
          <p class="text-xs text-text-secondary leading-relaxed mt-1 font-mono">
            {performanceNotes}
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3 pt-3 border-t border-border-subtle">
        <ShieldCheck className="w-5 h-5 text-cosmic-emerald shrink-0 mt-0.5" />
        <div>
          <h4 class="text-sm font-heading font-bold text-text-primary">Accessibility &amp; Motion Fallback</h4>
          <p class="text-xs text-text-secondary leading-relaxed mt-1 font-mono">
            {reducedMotionNotes}
          </p>
        </div>
      </div>
    </div>

    <!-- Long-form Technical Documentation -->
    <article class="prose prose-invert max-w-none my-10 leading-relaxed text-text-secondary border-t border-border-subtle pt-8">
      <Content />
    </article>

    <!-- Bottom Navigation -->
    <div class="mt-12 pt-8 border-t border-border-subtle flex items-center justify-between">
      <a
        href="/3d-lab"
        class="text-xs font-mono text-cosmic-cyan hover:underline inline-flex items-center gap-1.5"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Return to 3D Web Lab Directory</span>
      </a>
      <a
        href="/3d-lab/prompts"
        class="text-xs font-mono text-text-muted hover:text-cosmic-cyan transition-colors"
      >
        Explore 3D AI Prompt Vault &rarr;
      </a>
    </div>
  </PageContainer>
</BaseLayout>
