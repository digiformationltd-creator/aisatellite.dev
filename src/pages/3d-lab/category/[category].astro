---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { LAB_CATEGORIES } from '@/data/lab-categories';
import { Sparkles, ArrowRight, Layers, ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  return LAB_CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: { categoryMeta: cat },
  }));
}

const { categoryMeta } = Astro.props;
const allDemos = await getCollection('lab', ({ data }) => data.published);

// Filter demos matching this category
const matchingDemos = allDemos.filter((demo) => {
  const catLower = categoryMeta.slug.toLowerCase();
  const titleLower = demo.data.title.toLowerCase();
  const descLower = demo.data.description.toLowerCase();
  const techLower = demo.data.tech.map((t) => t.toLowerCase()).join(' ');
  const demoCatLower = demo.data.category.toLowerCase();

  if (catLower === 'threejs') return techLower.includes('three') || techLower.includes('webgl');
  if (catLower === 'shaders') return techLower.includes('shader') || techLower.includes('glsl') || titleLower.includes('shader');
  if (catLower === 'scroll-effects') return demoCatLower.includes('scroll') || titleLower.includes('scroll');
  if (catLower === 'templates') return true;
  if (catLower === 'react-three-fiber') return techLower.includes('react') || techLower.includes('three');
  return true;
});
---

<BaseLayout
  title={`${categoryMeta.name} — 3D Web Lab Showcase`}
  description={categoryMeta.description}
>
  <PageContainer class="py-10 max-w-5xl">
    <Breadcrumbs
      items={[
        { label: '3D Web Lab', href: '/3d-lab' },
        { label: categoryMeta.name },
      ]}
    />

    <SectionHeading
      badge="3D Category Showcase"
      title={categoryMeta.name}
      description={categoryMeta.description}
    />

    <!-- Quick Category Switcher -->
    <div class="flex items-center gap-2 flex-wrap justify-center my-6">
      <a
        href="/3d-lab"
        class="px-3 py-1.5 rounded-full text-xs font-mono bg-space-900 hover:bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle transition-colors"
      >
        All Categories
      </a>
      {LAB_CATEGORIES.map((cat) => {
        const isCurrent = cat.slug === categoryMeta.slug;
        return (
          <a
            href={`/3d-lab/category/${cat.slug}`}
            class={`px-3 py-1.5 rounded-full text-xs font-mono transition-colors ${
              isCurrent
                ? 'bg-cosmic-cyan text-space-950 font-bold shadow-glow-cyan/20'
                : 'bg-space-900 hover:bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle'
            }`}
          >
            {cat.name}
          </a>
        );
      })}
    </div>

    <!-- Demos Grid -->
    <div class="my-10">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-sm font-mono text-text-secondary">
          Showing <span class="text-cosmic-cyan font-bold">{matchingDemos.length}</span> components in {categoryMeta.name}
        </h3>
        <a href="/3d-lab" class="text-xs font-mono text-cosmic-cyan hover:underline flex items-center gap-1">
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>All 3D Experiments</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {matchingDemos.map((demo) => (
          <div class="cosmic-glass p-6 flex flex-col justify-between group border border-border-subtle hover:border-cosmic-cyan/40 transition-all rounded-card">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <Badge variant="cyan" size="sm">{demo.data.category}</Badge>
                <span class="text-[11px] font-mono text-cosmic-emerald">{demo.data.status}</span>
              </div>

              <h4 class="text-lg font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
                <a href={`/3d-lab/${demo.id}`}>{demo.data.title}</a>
              </h4>

              <p class="text-xs text-text-secondary leading-relaxed mb-4 line-clamp-3">
                {demo.data.description}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {demo.data.tech.map((t) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-space-950 text-text-muted border border-border-subtle">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
              <span class="text-[11px] font-mono text-text-muted">{demo.data.license} License</span>
              <a
                href={`/3d-lab/${demo.id}`}
                class="text-xs font-semibold text-cosmic-cyan hover:underline inline-flex items-center gap-1"
              >
                <span>Live Demo &amp; Code</span>
                <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </PageContainer>
</BaseLayout>
