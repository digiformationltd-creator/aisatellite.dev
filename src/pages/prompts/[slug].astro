---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import CopyButton from '@/components/ui/CopyButton.tsx';
import { Terminal, Cpu, Calendar, CheckCircle2 } from 'lucide-react';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts', ({ data }) => data.published);
  return prompts.map((prompt) => ({
    params: { slug: prompt.id },
    props: { prompt },
  }));
}

const { prompt } = Astro.props;
const { Content } = await render(prompt);
const { title, description, category, targetModel, systemPrompt, variables, exampleUsage, lastVerified } = prompt.data;
---

<BaseLayout
  title={`${title} — AI Prompt Directive`}
  description={description}
>
  <PageContainer size="narrow" class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Prompt Vault', href: '/prompts' },
        { label: title },
      ]}
    />

    <header class="mt-6 pb-6 border-b border-border-subtle">
      <div class="flex items-center gap-2 mb-3">
        <Badge variant="violet">{category}</Badge>
        <span class="text-xs font-mono text-cosmic-cyan flex items-center gap-1">
          <Cpu className="w-3.5 h-3.5" />
          {targetModel}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-text-primary tracking-tight">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-text-secondary leading-relaxed">
        {description}
      </p>

      <div class="mt-4 flex items-center gap-4 text-xs font-mono text-text-muted">
        <span class="flex items-center gap-1">
          <Calendar className="w-3.5 h-3.5 text-cosmic-emerald" />
          Verified: {lastVerified}
        </span>
        <span class="flex items-center gap-1">
          <CheckCircle2 className="w-3.5 h-3.5 text-cosmic-cyan" />
          Zero Hallucination Evaluated
        </span>
      </div>
    </header>

    <!-- Variables -->
    {variables.length > 0 && (
      <section class="my-6 p-4 rounded-card bg-space-900 border border-border-subtle">
        <h2 class="text-xs font-mono font-bold text-text-muted uppercase tracking-wider mb-2">
          Interpolation Variables & Placeholders
        </h2>
        <div class="flex flex-wrap gap-2">
          {variables.map((v) => (
            <span class="px-2.5 py-1 text-xs font-mono rounded bg-space-950 text-cosmic-amber border border-border-subtle font-semibold">
              {"{{" + v + "}}"}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Complete Copyable Prompt -->
    <section class="my-8">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-mono font-bold text-text-primary uppercase tracking-wider flex items-center gap-2">
          <Terminal className="w-4 h-4 text-cosmic-violet" />
          <span>Complete System Prompt</span>
        </h2>
        <CopyButton client:visible text={systemPrompt} label="Copy Full Prompt" />
      </div>

      <div class="relative rounded-card bg-space-950 p-5 border border-border-subtle overflow-x-auto">
        <pre class="text-xs font-mono text-cosmic-cyan leading-relaxed whitespace-pre-wrap">{systemPrompt}</pre>
      </div>
    </section>

    <!-- Usage Guidance -->
    <section class="my-6 p-4 rounded-card bg-space-900/60 border border-border-subtle text-xs font-mono">
      <span class="text-text-muted block mb-1">Recommended Integration:</span>
      <span class="text-text-secondary">{exampleUsage}</span>
    </section>

    <!-- Markdown Article Details -->
    <article class="prose prose-invert max-w-none my-8 leading-relaxed text-text-secondary">
      <Content />
    </article>

    <div class="mt-12 pt-8 border-t border-border-subtle text-center">
      <a href="/prompts" class="text-sm font-mono text-cosmic-cyan hover:underline">
        &larr; Return to All Prompts
      </a>
    </div>
  </PageContainer>
</BaseLayout>
