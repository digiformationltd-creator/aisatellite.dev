---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import PromptCard from '@/components/cards/PromptCard.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';

export async function getStaticPaths() {
  const allPrompts = await getCollection('prompts', ({ data }) => data.published);
  const categories = Array.from(new Set(allPrompts.map((p) => p.data.category)));

  return categories.map((cat) => {
    const slug = cat.toLowerCase().replace(/\s+/g, '-');
    return {
      params: { category: slug },
      props: {
        categoryName: cat,
        prompts: allPrompts.filter((p) => p.data.category === cat),
      },
    };
  });
}

const { categoryName, prompts } = Astro.props;
---

<BaseLayout
  title={`${categoryName} AI Prompts — AI Satellite`}
  description={`Production-grade ${categoryName} prompts and system directives for frontier AI models.`}
>
  <PageContainer class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Prompt Vault', href: '/prompts' },
        { label: categoryName },
      ]}
    />

    <SectionHeading
      badge="Prompt Category"
      title={`${categoryName} Prompts`}
      description={`Curated system directives and context injection templates specialized for ${categoryName.toLowerCase()}.`}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {
        prompts.map((prompt) => (
          <PromptCard prompt={prompt} />
        ))
      }
    </div>

    <div class="mt-12 text-center pt-8 border-t border-border-subtle">
      <a href="/prompts" class="text-sm font-mono text-cosmic-cyan hover:underline">
        &larr; Return to Prompt Vault Directory
      </a>
    </div>
  </PageContainer>
</BaseLayout>
