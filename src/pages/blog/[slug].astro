---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import PartnerRecommendation from '@/components/partners/PartnerRecommendation.astro';
import PartnerDisclosure from '@/components/partners/PartnerDisclosure.astro';
import { Calendar, Clock, User, ExternalLink, BookOpen, ShieldCheck } from 'lucide-react';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => data.published);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const {
  title,
  description,
  category,
  tags,
  author,
  publishedAt,
  updatedAt,
  readingTime,
  sources,
  partnerContext,
  editoriallyReviewed,
} = article.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
  },
  datePublished: publishedAt,
  dateModified: updatedAt || publishedAt,
  publisher: {
    '@type': 'Organization',
    name: 'AI Satellite',
    url: 'https://aisatellite.pages.dev',
  },
};
---

<BaseLayout
  title={`${title} — Founder Playbook`}
  description={description}
  type="article"
  jsonLd={jsonLd}
>
  <PageContainer size="narrow" class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Playbooks', href: '/playbooks' },
        { label: title },
      ]}
    />

    <header class="mt-6 pb-6 border-b border-border-subtle">
      <div class="flex items-center gap-2 mb-3">
        <Badge variant="cyan">{category}</Badge>
        {editoriallyReviewed && (
          <span class="text-xs font-mono text-cosmic-emerald flex items-center gap-1">
            <ShieldCheck className="w-3.5 h-3.5" />
            Peer Reviewed
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-heading font-extrabold text-text-primary tracking-tight leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-lg text-text-secondary leading-relaxed font-sans">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-mono text-text-muted">
        <span class="flex items-center gap-1.5 text-text-secondary">
          <User className="w-3.5 h-3.5 text-cosmic-cyan" />
          {author}
        </span>
        <span class="flex items-center gap-1.5">
          <Calendar className="w-3.5 h-3.5 text-cosmic-emerald" />
          Published: {publishedAt}
        </span>
        <span class="flex items-center gap-1.5">
          <Clock className="w-3.5 h-3.5 text-cosmic-violet" />
          {readingTime}
        </span>
      </div>
    </header>

    <!-- Contextual Partner Recommendation (if context matches) -->
    {partnerContext === 'digiformation' && (
      <PartnerRecommendation
        partner="digiformation"
        context="Global Company Incorporation"
        title="Form a UK Company & Unlock Stripe from Anywhere"
        description="Need an official UK Companies House registered LTD, London registered office address, and business banking assistance? Explore DigiFormation's verified compliance packages."
        disclosure="Commercially associated partner resource."
      />
    )}

    {partnerContext === 'digibizos' && (
      <PartnerRecommendation
        partner="digibizos"
        context="Agency Automation Stack"
        title="Unify Your Agency Operations with Digi Biz OS"
        description="Looking for an all-in-one business management OS with built-in CRM, invoicing, project management, and automated client communication? Test Digi Biz OS today."
        disclosure="Commercially associated partner resource."
      />
    )}

    <!-- Markdown Body -->
    <article class="prose prose-invert max-w-none my-8 leading-relaxed text-text-secondary text-base">
      <Content />
    </article>

    <!-- Sources & Attributions -->
    {sources.length > 0 && (
      <section class="my-10 p-5 rounded-card bg-space-900 border border-border-subtle">
        <h2 class="text-xs font-mono font-bold text-text-primary uppercase tracking-wider mb-3 flex items-center gap-2">
          <BookOpen className="w-4 h-4 text-cosmic-cyan" />
          <span>Verified Reference Sources</span>
        </h2>
        <ul class="space-y-2 text-xs font-mono">
          {sources.map((src) => (
            <li>
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cosmic-cyan hover:underline inline-flex items-center gap-1.5"
              >
                <span>{src.title}</span>
                <ExternalLink className="w-3 h-3" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Commercial Disclosure Notice -->
    <PartnerDisclosure />

    <div class="mt-12 pt-8 border-t border-border-subtle text-center">
      <a href="/playbooks" class="text-sm font-mono text-cosmic-cyan hover:underline">
        &larr; Return to All Founder Playbooks
      </a>
    </div>
  </PageContainer>
</BaseLayout>
