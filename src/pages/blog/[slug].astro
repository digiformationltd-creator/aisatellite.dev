---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import TableOfContents from '@/components/blog/TableOfContents.tsx';
import ContextualCTA from '@/components/blog/ContextualCTA.tsx';
import CommercialDisclosure from '@/components/blog/CommercialDisclosure.astro';
import AeoAnswerBox from '@/components/blog/AeoAnswerBox.astro';
import ImplementationChecklist from '@/components/blog/ImplementationChecklist.astro';
import SourceCitations from '@/components/blog/SourceCitations.astro';
import NewsletterBox from '@/components/blog/NewsletterBox.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import { blogDatabase } from '@/lib/blog/database';
import { blogSEO } from '@/lib/blog/seo-engine';
import { ctaEngine } from '@/lib/blog/cta-engine';
import type { ArticleModel } from '@/lib/blog/types';
import type { TocItem } from '@/components/blog/TableOfContents.tsx';
import {
  Calendar,
  Clock,
  User,
  ShieldCheck,
  CheckCircle2,
  Tag,
  ArrowLeft,
  Sparkles,
} from 'lucide-react';

export async function getStaticPaths() {
  const storeArticles = blogDatabase.getArticles(false);
  const collectionEntries = await getCollection('blog', ({ data }) => data.published);

  // Index collection entries by id/slug
  const collectionMap = new Map();
  collectionEntries.forEach((entry) => {
    collectionMap.set(entry.id, entry);
  });

  const allSlugs = new Set([
    ...storeArticles.map((a) => a.slug),
    ...collectionEntries.map((e) => e.id),
  ]);

  const paths = [];

  for (const slug of allSlugs) {
    const storeArt = storeArticles.find((a) => a.slug === slug);
    const colEntry = collectionMap.get(slug);

    let article: ArticleModel;

    if (storeArt) {
      article = storeArt;
    } else if (colEntry) {
      // Normalize collection entry into ArticleModel
      article = {
        id: colEntry.id,
        slug: colEntry.id,
        title: colEntry.data.title,
        description: colEntry.data.description,
        primaryCategory: colEntry.data.category as any,
        secondaryCategories: [],
        tags: colEntry.data.tags || [],
        author: {
          id: 'author-default',
          name: colEntry.data.author || 'AI Satellite Editorial Team',
          role: 'Technology Researcher',
          bio: 'Verified technical research engineer at AI Satellite.',
          avatarUrl: '/images/authors/research-team.png',
          credentials: ['Verified Technology Researcher'],
          verifiedExpert: true,
        },
        publishedAt: colEntry.data.publishedAt,
        readingTime: colEntry.data.readingTime || '7 min read',
        reviewStatus: 'Published',
        editoriallyReviewed: colEntry.data.editoriallyReviewed ?? true,
        targetAudience: ['Developers', 'Founders'],
        jurisdiction: 'Global',
        searchIntent: 'informational',
        contentBody: colEntry.body || '',
        keyTakeaways: [],
        practicalSteps: [],
        checklist: [],
        commonMistakes: [],
        canonicalUrl: `https://aisatellite.dev/blog/${colEntry.id}`,
        indexable: true,
        featured: false,
        published: true,
        sourceReferences: colEntry.data.sources || [],
        relatedTools: colEntry.data.relatedTools || [],
        relatedArticles: colEntry.data.relatedArticles || [],
        ctaPlacements: [],
      };
    } else {
      continue;
    }

    paths.push({
      params: { slug },
      props: { article, collectionEntry: colEntry },
    });
  }

  return paths;
}

const { article, collectionEntry } = Astro.props;

// Render content collection body if present
let ContentComponent: any = null;
if (collectionEntry) {
  const rendered = await render(collectionEntry);
  ContentComponent = rendered.Content;
}

const authorName =
  typeof article.author === 'string' ? article.author : article.author.name;
const authorRole =
  typeof article.author === 'string'
    ? 'Technology Researcher'
    : article.author.role;
const authorBio =
  typeof article.author === 'string'
    ? 'AI Satellite Verified Contributor'
    : article.author.bio;
const authorCredentials =
  typeof article.author === 'string' ? [] : article.author.credentials || [];

const formattedDate = new Date(article.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categorySlug = article.primaryCategory
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

// Ensure Contextual CTA is available if none are explicitly assigned
const activeCTAs =
  article.ctaPlacements && article.ctaPlacements.length > 0
    ? article.ctaPlacements
    : [
        ctaEngine.matchCTA({
          articleId: article.id,
          category: article.primaryCategory,
          tags: article.tags,
          jurisdiction: article.jurisdiction,
        }),
      ].filter(Boolean);

// Detect whether commercial disclosure applies
const hasCommercialRecommendation = activeCTAs.some(
  (c) => c && (c.partner === 'digiformation' || c.partner === 'digibizos')
);

// Table of Contents items
const defaultTocItems = [
  { id: 'quick-answer', title: 'Quick Answer & Key Takeaways', level: 2 },
  { id: 'overview', title: 'Executive Overview', level: 2 },
  { id: 'guide', title: 'Practical Implementation Guide', level: 2 },
  ...(article.checklist && article.checklist.length > 0
    ? [{ id: 'checklist', title: 'Implementation Checklist', level: 2 }]
    : []),
  ...(hasCommercialRecommendation
    ? [{ id: 'recommendations', title: 'Contextual Solution & Recommendation', level: 2 }]
    : []),
  ...(article.sourceReferences && article.sourceReferences.length > 0
    ? [{ id: 'sources', title: 'Research Sources & Empirical Evidence', level: 2 }]
    : []),
];

const relatedArticles = blogDatabase
  .getArticles(false)
  .filter((a) => a.id !== article.id)
  .slice(0, 3);

const jsonLd = blogSEO.generateArticleJsonLd(article);
---

<BaseLayout
  title={`${article.title} — AI Satellite`}
  description={article.description}
  canonical={`https://aisatellite.dev/blog/${article.slug}`}
  type="article"
  jsonLd={jsonLd}
>
  <PageContainer size="wide" class="py-10">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog & Knowledge Hub', href: '/blog' },
        { label: article.primaryCategory, href: `/blog/category/${categorySlug}` },
        { label: article.title, href: `/blog/${article.slug}` },
      ]}
    />

    <article class="mt-8">
      <!-- Article Header -->
      <header class="max-w-4xl mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <a href={`/blog/category/${categorySlug}`}>
            <Badge variant="cyan" size="md">
              {article.primaryCategory}
            </Badge>
          </a>

          {
            article.editoriallyReviewed && (
              <span class="inline-flex items-center gap-1 text-xs font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <ShieldCheck className="w-3.5 h-3.5" />
                <span>Editorially Reviewed</span>
              </span>
            )
          }

          {
            article.jurisdiction && article.jurisdiction !== 'Global' && (
              <span class="text-xs font-mono text-text-muted">
                &bull; Jurisdiction: {article.jurisdiction}
              </span>
            )
          }
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black text-text-primary tracking-tight leading-[1.15] mb-6">
          {article.title}
        </h1>

        <p class="text-lg sm:text-xl text-text-secondary leading-relaxed mb-6">
          {article.description}
        </p>

        <!-- Author, Date & Reading Time Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-border-subtle text-xs font-mono text-text-muted">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-space-850 border border-cosmic-cyan/40 flex items-center justify-center text-cosmic-cyan font-bold">
              <User className="w-4 h-4" />
            </div>
            <div>
              <div class="font-bold text-text-primary">{authorName}</div>
              <div class="text-[11px] text-text-muted">{authorRole}</div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span class="flex items-center gap-1">
              <Calendar className="w-3.5 h-3.5 text-cosmic-cyan" />
              {formattedDate}
            </span>
            <span class="flex items-center gap-1">
              <Clock className="w-3.5 h-3.5 text-cosmic-teal" />
              {article.readingTime}
            </span>
          </div>
        </div>
      </header>

      <!-- Main Layout: Sidebar TOC + Article Reading Column -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <!-- Main Column (8 cols on lg) -->
        <main class="lg:col-span-8 min-w-0">
          <!-- 26. AEO Quick Answer & Key Takeaways -->
          <div id="quick-answer">
            <AeoAnswerBox
              quickAnswer={article.quickAnswer}
              keyTakeaways={article.keyTakeaways}
            />
          </div>

          <!-- Executive Overview / Summary -->
          {
            article.summary && (
              <div id="overview" class="my-6 p-5 rounded-card bg-space-900/60 border border-border-subtle/70 text-text-secondary text-base leading-relaxed">
                <p>{article.summary}</p>
              </div>
            )
          }

          <!-- Practical Steps if structured -->
          {
            article.practicalSteps && article.practicalSteps.length > 0 && (
              <div class="my-8 space-y-4">
                <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
                  Step-by-Step Practical Blueprint
                </h2>
                <div class="space-y-4">
                  {article.practicalSteps.map((step) => (
                    <div class="p-4 sm:p-5 rounded-card bg-space-900 border border-border-subtle">
                      <div class="flex items-center gap-2 mb-2 font-heading font-bold text-base text-cosmic-cyan">
                        <span class="w-6 h-6 rounded-full bg-cosmic-cyan/15 flex items-center justify-center text-xs font-mono">
                          {step.step}
                        </span>
                        <h3>{step.title}</h3>
                      </div>
                      <p class="text-sm text-text-secondary leading-relaxed pl-8">
                        {step.detail}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Body Content (Markdown Content Collection or Content Body) -->
          <div
            id="guide"
            class="prose prose-invert prose-cyan max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-a:text-cosmic-cyan hover:prose-a:underline prose-code:text-cosmic-cyan prose-code:font-mono prose-pre:bg-space-950 prose-pre:border prose-pre:border-border-subtle my-8 text-text-secondary text-base sm:text-lg leading-relaxed"
          >
            {ContentComponent ? (
              <ContentComponent />
            ) : (
              <div set:html={article.contentBody.replace(/\n\n/g, '<br/><br/>')} />
            )}
          </div>

          <!-- Implementation Checklist -->
          {
            article.checklist && article.checklist.length > 0 && (
              <div id="checklist">
                <ImplementationChecklist items={article.checklist} />
              </div>
            )
          }

          <!-- Contextual Commercial CTA Placements -->
          <div id="recommendations">
            {
              activeCTAs.map((cta) => (
                cta && <ContextualCTA client:visible cta={cta} articleId={article.id} />
              ))
            }
          </div>

          <!-- 16. Commercial Disclosure Policy Notice (Commercially associated partner resource) -->
          <CommercialDisclosure hasCommercialContent={hasCommercialRecommendation} />

          <!-- 24. Verified Source References & Evidence -->
          {
            article.sourceReferences && article.sourceReferences.length > 0 && (
              <div id="sources">
                <SourceCitations sources={article.sourceReferences} />
              </div>
            )
          }

          <!-- Author Bio Box -->
          <div class="p-6 rounded-card bg-space-900 border border-border-subtle my-10 flex flex-col sm:flex-row items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-space-850 border border-cosmic-cyan/40 flex items-center justify-center text-cosmic-cyan flex-shrink-0 text-xl font-bold">
              <User className="w-6 h-6" />
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-heading font-bold text-lg text-text-primary">
                  {authorName}
                </h3>
                <span class="text-xs font-mono text-cosmic-cyan px-2 py-0.5 rounded bg-cosmic-cyan/10">
                  {authorRole}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-text-secondary leading-relaxed mb-3">
                {authorBio}
              </p>
              {authorCredentials.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {authorCredentials.map((cred) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-space-800 text-text-muted border border-border-subtle">
                      ✓ {cred}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>

          <!-- Tags -->
          {
            article.tags && article.tags.length > 0 && (
              <div class="flex flex-wrap items-center gap-2 my-8 pt-4 border-t border-border-subtle">
                <Tag className="w-3.5 h-3.5 text-text-muted" />
                <span class="text-xs font-mono text-text-muted">Tags:</span>
                {article.tags.map((tag) => (
                  <a
                    href={`/blog/topic/${tag}`}
                    class="text-xs font-mono px-2.5 py-1 rounded bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle hover:border-cosmic-cyan/40 transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }

          <!-- Newsletter Box -->
          <NewsletterBox topic={article.primaryCategory} />
        </main>

        <!-- Sidebar (4 cols on lg) -->
        <aside class="lg:col-span-4 space-y-6">
          <!-- Sticky Table of Contents -->
          <div class="sticky top-24 space-y-6">
            <TableOfContents client:load items={defaultTocItems} />

            <!-- Related Articles Widget -->
            {
              relatedArticles.length > 0 && (
                <div class="p-5 rounded-card bg-space-900/80 border border-border-subtle">
                  <h3 class="text-xs font-mono font-bold text-text-primary uppercase tracking-wider mb-4 text-cosmic-cyan">
                    Related Playbooks
                  </h3>
                  <div class="space-y-4">
                    {relatedArticles.map((rel) => (
                      <a
                        href={`/blog/${rel.slug}`}
                        class="block group text-xs text-text-secondary hover:text-cosmic-cyan transition-colors"
                      >
                        <div class="font-semibold text-text-primary group-hover:text-cosmic-cyan leading-snug mb-1">
                          {rel.title}
                        </div>
                        <div class="text-[11px] font-mono text-text-muted">
                          {rel.primaryCategory} &bull; {rel.readingTime}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </article>
  </PageContainer>
</BaseLayout>
