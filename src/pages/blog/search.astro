---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import BlogSearch from '@/components/blog/BlogSearch.tsx';
import { blogDatabase } from '@/lib/blog/database';
import { Search } from 'lucide-react';

const allArticles = blogDatabase.getArticles(false);
const categories = blogDatabase.getCategories();

const query = Astro.url.searchParams.get('q') || '';
const categoryFilter = Astro.url.searchParams.get('category') || '';
---

<BaseLayout
  title="Search Blog Hub & Knowledge Universe — AI Satellite"
  description="Search across 1,000+ technology and business guides, verified free developer tools, and open-source alternatives."
  canonical="https://aisatellite.dev/blog/search"
  noIndex={true}
>
  <PageContainer class="py-12 space-y-8">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog & Knowledge Hub', href: '/blog' },
        { label: 'Search', href: '/blog/search' },
      ]}
    />

    <header class="max-w-3xl">
      <div class="flex items-center gap-2 mb-2 text-cosmic-cyan text-sm font-mono">
        <Search className="w-4 h-4" />
        <span>Universal Search Index</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-heading font-black text-text-primary tracking-tight">
        Search Technology &amp; Business Playbooks
      </h1>
      <p class="text-sm sm:text-base text-text-secondary mt-2">
        Instant keyword discovery across all published guides, categories, open-source repositories, and developer tutorials.
      </p>
    </header>

    <BlogSearch
      client:load
      articles={allArticles}
      categories={categories}
      initialQuery={query}
      initialCategory={categoryFilter}
    />
  </PageContainer>
</BaseLayout>
