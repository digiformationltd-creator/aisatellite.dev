---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import BlogHero from '@/components/blog/BlogHero.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import NewsletterBox from '@/components/blog/NewsletterBox.astro';
import Badge from '@/components/ui/Badge.astro';
import { blogDatabase } from '@/lib/blog/database';
import {
  Sparkles,
  TrendingUp,
  Briefcase,
  Cpu,
  Layers,
  GitBranch,
  Landmark,
  PlayCircle,
  Code2,
  Building2,
  FolderOpen,
  Award,
  BookOpen,
  Terminal,
  ArrowRight,
} from 'lucide-react';

const allArticles = blogDatabase.getArticles(false);
const categories = blogDatabase.getCategories();
const featuredArticles = allArticles.filter((a) => a.featured);
const latestArticles = blogDatabase.getLatestArticles(6);

// Segmented lists for Section 6 requirements
const businessGuides = allArticles.filter(
  (a) => a.primaryCategory === 'Business Growth' || a.primaryCategory === 'Business Startup Guides'
);
const industryGuides = allArticles.filter((a) => a.primaryCategory === 'Industry-Specific Growth');
const ukUsGuides = allArticles.filter(
  (a) => a.primaryCategory === 'UK Business' || a.primaryCategory === 'US Business'
);
const openSourceArticles = allArticles.filter(
  (a) => a.primaryCategory === 'Open-Source Software' || a.primaryCategory === 'GitHub Projects'
);
const automationArticles = allArticles.filter(
  (a) => a.primaryCategory === 'Workflow Automation' || a.primaryCategory === 'AI Automation'
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI Satellite Blog & Editorial Knowledge Hub',
  description:
    'Discover free AI tools, open-source software, smarter alternatives, practical business guides, and developer knowledge.',
  url: 'https://aisatellite.dev/blog',
  isPartOf: {
    '@type': 'WebSite',
    name: 'AI Satellite',
    url: 'https://aisatellite.dev',
  },
};
---

<BaseLayout
  title="Blog & Editorial Knowledge Universe — AI Satellite"
  description="Explore verified free developer tools, open-source software alternatives, business growth playbooks, and international company architecture guides."
  canonical="https://aisatellite.dev/blog"
  jsonLd={jsonLd}
>
  <!-- 5. Cinematic Editorial Hero -->
  <BlogHero totalArticles={allArticles.length} />

  <PageContainer class="py-12 space-y-16">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog & Knowledge Hub', href: '/blog' },
      ]}
    />

    <!-- 1. Featured Research -->
    {
      featuredArticles.length > 0 && (
        <section aria-label="Featured Research">
          <div class="flex items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-2">
              <Sparkles className="w-5 h-5 text-cosmic-cyan" />
              <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
                Featured Research &amp; Flagship Guides
              </h2>
            </div>
            <span class="text-xs font-mono text-text-muted hidden sm:inline-block">
              Peer-Reviewed &bull; Verified Sources
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredArticles.map((art) => (
              <ArticleCard article={art} featured={true} />
            ))}
          </div>
        </section>
      )
    }

    <!-- 2. Latest Articles -->
    <section aria-label="Latest Articles">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <TrendingUp className="w-5 h-5 text-cosmic-teal" />
          <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
            Latest Publications
          </h2>
        </div>
        <a
          href="/blog/latest"
          class="text-xs font-semibold text-cosmic-cyan hover:underline flex items-center gap-1"
        >
          <span>View All Latest</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestArticles.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>

    <!-- 3 & 10. Industry-Specific Business Guides (Including Car Dealership Reference Guide) -->
    <section aria-label="Industry-Specific Growth">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <Building2 className="w-5 h-5 text-amber-400" />
          <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
            Industry-Specific Business Growth Guides
          </h2>
        </div>
        <a
          href="/blog/category/industry-specific-growth"
          class="text-xs font-semibold text-cosmic-cyan hover:underline flex items-center gap-1"
        >
          <span>All Industry Guides</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          (industryGuides.length > 0 ? industryGuides : allArticles.slice(0, 3)).map((art) => (
            <ArticleCard article={art} />
          ))
        }
      </div>
    </section>

    <!-- 6 & 8. Open-Source, Free Tools & Workflows -->
    <section aria-label="Automation and Open Source">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <PlayCircle className="w-5 h-5 text-cosmic-purple" />
          <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
            Automation, Workflows &amp; Open-Source Tools
          </h2>
        </div>
        <a
          href="/blog/category/workflow-automation"
          class="text-xs font-semibold text-cosmic-cyan hover:underline flex items-center gap-1"
        >
          <span>Explore Automation</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          (automationArticles.length > 0 ? automationArticles : allArticles.slice(0, 3)).map((art) => (
            <ArticleCard article={art} />
          ))
        }
      </div>
    </section>

    <!-- 7. UK and International Business Guides -->
    <section aria-label="International Business">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
          <Landmark className="w-5 h-5 text-cosmic-cyan" />
          <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
            UK, US &amp; International Business Formation
          </h2>
        </div>
        <a
          href="/blog/category/uk-business"
          class="text-xs font-semibold text-cosmic-cyan hover:underline flex items-center gap-1"
        >
          <span>All Corporate Guides</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          (ukUsGuides.length > 0 ? ukUsGuides : allArticles.slice(0, 3)).map((art) => (
            <ArticleCard article={art} />
          ))
        }
      </div>
    </section>

    <!-- 10. All 25 Editorial Categories Directory -->
    <section aria-label="Editorial Categories Directory">
      <div class="flex items-center gap-2 mb-6">
        <FolderOpen className="w-5 h-5 text-text-muted" />
        <h2 class="text-xl sm:text-2xl font-heading font-black text-text-primary">
          Explore by Topic Category
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {
          categories.map((cat) => (
            <a
              href={`/blog/category/${cat.slug}`}
              class="p-4 rounded-xl bg-space-900 border border-border-subtle hover:border-cosmic-cyan/50 hover:bg-space-850 transition-all group flex flex-col justify-between"
            >
              <div class="text-xs font-semibold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
                {cat.name}
              </div>
              <div class="text-[11px] font-mono text-text-muted">
                {cat.articleCount} {cat.articleCount === 1 ? 'article' : 'articles'}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 15. Newsletter Integration -->
    <NewsletterBox topic="Weekly Technology & Business Knowledge" />
  </PageContainer>
</BaseLayout>
