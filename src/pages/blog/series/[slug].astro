---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Badge from '@/components/ui/Badge.astro';
import { blogDatabase } from '@/lib/blog/database';
import { Layers, Bookmark, CheckCircle2 } from 'lucide-react';

export async function getStaticPaths() {
  const allArticles = blogDatabase.getArticles(false);
  const seriesMap = new Map<string, { id: string; name: string; articles: any[] }>();

  allArticles.forEach((art) => {
    if (art.series) {
      if (!seriesMap.has(art.series.id)) {
        seriesMap.set(art.series.id, {
          id: art.series.id,
          name: art.series.name,
          articles: [],
        });
      }
      seriesMap.get(art.series.id)!.articles.push(art);
    }
  });

  // Fallback for default series if empty
  if (seriesMap.size === 0) {
    seriesMap.set('series-business-automation', {
      id: 'series-business-automation',
      name: 'Business Automation Master Series',
      articles: allArticles.slice(0, 2),
    });
  }

  return Array.from(seriesMap.values()).map((s) => ({
    params: { slug: s.id },
    props: { series: s },
  }));
}

const { series } = Astro.props;
const sortedArticles = [...series.articles].sort(
  (a, b) => (a.series?.order || 0) - (b.series?.order || 0)
);
---

<BaseLayout
  title={`${series.name} — AI Satellite Editorial Series`}
  description={`Comprehensive pillar guide and topic cluster: ${series.name}. Master practical business growth and technology automation.`}
  canonical={`https://aisatellite.dev/blog/series/${series.id}`}
>
  <PageContainer class="py-12 space-y-12">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog & Knowledge Hub', href: '/blog' },
        { label: 'Topic Clusters', href: '/blog' },
        { label: series.name, href: `/blog/series/${series.id}` },
      ]}
    />

    <header class="p-8 sm:p-10 rounded-card bg-gradient-to-br from-space-900 to-space-850 border border-border-subtle shadow-orbital-glass">
      <div class="inline-flex items-center gap-2 mb-4">
        <Badge variant="cyan" size="md">
          <Layers className="w-3.5 h-3.5 mr-1 inline" />
          Pillar &amp; Topic Cluster Series
        </Badge>
        <span class="text-xs font-mono text-text-muted">
          {sortedArticles.length} Sequential Parts
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-heading font-black text-text-primary tracking-tight mb-4">
        {series.name}
      </h1>

      <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-3xl">
        A structured editorial learning track designed to guide founders and developers through each milestone—from foundational architecture to autonomous production workflows.
      </p>
    </header>

    <section class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary">
        Series Roadmap &bull; Modules in this Cluster
      </h2>

      <div class="space-y-4">
        {
          sortedArticles.map((art, idx) => (
            <div class="p-5 rounded-card bg-space-900 border border-border-subtle hover:border-cosmic-cyan/50 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4 group">
              <div class="flex items-start gap-4">
                <span class="w-8 h-8 rounded-xl bg-space-850 border border-cosmic-cyan/40 flex items-center justify-center font-mono font-bold text-sm text-cosmic-cyan flex-shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <div>
                  <h3 class="font-heading font-bold text-base sm:text-lg text-text-primary group-hover:text-cosmic-cyan transition-colors mb-1">
                    <a href={`/blog/${art.slug}`}>{art.title}</a>
                  </h3>
                  <p class="text-xs sm:text-sm text-text-secondary line-clamp-2">
                    {art.description}
                  </p>
                </div>
              </div>

              <a
                href={`/blog/${art.slug}`}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-space-850 hover:bg-space-800 text-xs font-semibold text-cosmic-cyan border border-border-subtle hover:border-cosmic-cyan/40 transition-colors flex-shrink-0"
              >
                <span>Read Module</span>
                &rarr;
              </a>
            </div>
          ))
        }
      </div>
    </section>
  </PageContainer>
</BaseLayout>
