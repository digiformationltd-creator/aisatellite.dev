---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import OrbitalIntelligenceSearch from '@/components/search/OrbitalIntelligenceSearch';
import { Search } from 'lucide-react';
---

<BaseLayout
  title="AI Satellite Intelligence Search — The Global Developer Radar"
  description="Ask anything: find verified free alternatives, compare open-source tools, generate grounded architectural answers, and explore developer solutions."
>
  <PageContainer size="wide" class="py-10">
    <Breadcrumbs items={[{ label: 'Intelligence Search' }]} />

    <SectionHeading
      badge="Hybrid Intelligence Engine"
      title="Satellite Intelligence Search"
      description="What do you want to build, replace, automate or solve? Natural-language problem solving, verified free-alternative matching, and source-grounded answers."
    />

    <!-- Orbital Intelligence Search Island -->
    <div class="my-8">
      <OrbitalIntelligenceSearch client:load />
    </div>

    <!-- Static Pagefind Fallback / Archive Search -->
    <div class="mt-16 pt-10 border-t border-white/5 space-y-6">
      <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-text-muted">
        <Search className="w-4 h-4 text-cosmic-cyan" />
        <span>Static Full-Text Pagefind Index</span>
      </div>

      <div id="pagefind-search" class="min-h-[160px]">
        <div class="p-6 rounded-card bg-space-900 border border-white/5 text-center text-text-muted">
          <p class="text-xs font-mono text-text-secondary">Initializing static token index...</p>
        </div>
      </div>
    </div>
  </PageContainer>
</BaseLayout>

<link href="/_pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/_pagefind/pagefind-ui.js" type="text/javascript"></script>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    // @ts-ignore
    if (typeof PagefindUI !== 'undefined') {
      const container = document.getElementById('pagefind-search');
      if (container) {
        container.innerHTML = '';
        // @ts-ignore
        new PagefindUI({
          element: '#pagefind-search',
          showSubResults: true,
          showImages: false,
        });
      }
    }
  });
</script>
