---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { Box, ShieldCheck, GitPullRequest, Terminal, CheckCircle2, ArrowRight } from 'lucide-react';
---

<BaseLayout
  title="Submit an Open-Source Software Project — AI Satellite"
  description="Submit your open-source software project or free alternative to AI Satellite for verification, cataloging, and global distribution."
>
  <PageContainer class="py-10 max-w-4xl">
    <Breadcrumbs items={[{ label: 'Submit Project' }]} />

    <SectionHeading
      badge="Ecosystem Contributions"
      title="Submit an Open-Source Project"
      description="Do you build legitimate open-source software or maintain a privacy-first free alternative? Submit your repository for automated verification and global distribution."
    />

    <!-- Verification Standards Checklist -->
    <div class="my-8 cosmic-glass p-6 md:p-8 rounded-card border border-border-subtle space-y-4">
      <h2 class="text-base font-heading font-bold text-text-primary flex items-center gap-2">
        <ShieldCheck className="w-5 h-5 text-cosmic-emerald" />
        <span>Verification Criteria &amp; Ground Truth Standard</span>
      </h2>
      <p class="text-xs text-text-secondary leading-relaxed">
        AI Satellite maintains an uncompromising standard of editorial and technical integrity. To be listed, your project must fulfill:
      </p>

      <ul class="space-y-2.5 text-xs font-mono text-text-secondary">
        <li class="flex items-start gap-2">
          <CheckCircle2 className="w-4 h-4 text-cosmic-emerald shrink-0 mt-0.5" />
          <span><strong>Permissive or Copyleft FOSS License:</strong> Valid OSI-approved license (MIT, Apache 2.0, GPL, AGPL, BSD, MPL).</span>
        </li>
        <li class="flex items-start gap-2">
          <CheckCircle2 className="w-4 h-4 text-cosmic-emerald shrink-0 mt-0.5" />
          <span><strong>Public Source Code:</strong> Verifiable GitHub/GitLab repository with active release tags or commits.</span>
        </li>
        <li class="flex items-start gap-2">
          <CheckCircle2 className="w-4 h-4 text-cosmic-emerald shrink-0 mt-0.5" />
          <span><strong>Zero Malware / Bundled Adware:</strong> Binaries must pass VirusTotal / ClamAV checks and include reproducible build recipes.</span>
        </li>
        <li class="flex items-start gap-2">
          <CheckCircle2 className="w-4 h-4 text-cosmic-emerald shrink-0 mt-0.5" />
          <span><strong>Truthful Pricing Classification:</strong> No deceptive "Free" labels on locked SaaS trials. Free tiers must have clear boundaries.</span>
        </li>
      </ul>
    </div>

    <!-- Submission Process -->
    <div class="my-8 cosmic-glass p-6 md:p-8 rounded-card border border-border-subtle space-y-6">
      <h2 class="text-base font-heading font-bold text-text-primary flex items-center gap-2">
        <GitPullRequest className="w-5 h-5 text-cosmic-cyan" />
        <span>How to Submit via Git Pull Request (Fastest Method)</span>
      </h2>

      <p class="text-xs text-text-secondary leading-relaxed">
        Our content collections are 100% open-source and file-based. You can submit your project directly by adding a markdown entry to <code>src/content/projects/</code> or <code>src/content/alternatives/</code>:
      </p>

      <div class="space-y-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-space-950 border border-border-subtle space-y-2">
          <span class="text-cosmic-cyan font-bold">1. Fork the AI Satellite Repository</span>
          <pre class="text-slate-300"><code>git clone https://github.com/digi-ai/ai-satellite.git<br />cd ai-satellite</code></pre>
        </div>

        <div class="p-4 rounded-xl bg-space-950 border border-border-subtle space-y-2">
          <span class="text-cosmic-cyan font-bold">2. Create Your Project File</span>
          <p class="text-text-muted">Create a new markdown file in <code>src/content/projects/your-project.md</code> following the frontmatter schema.</p>
        </div>

        <div class="p-4 rounded-xl bg-space-950 border border-border-subtle space-y-2">
          <span class="text-cosmic-cyan font-bold">3. Validate with Astro &amp; Test Suite</span>
          <pre class="text-slate-300"><code>npm test<br />npx astro check</code></pre>
        </div>

        <div class="p-4 rounded-xl bg-space-950 border border-border-subtle space-y-2">
          <span class="text-cosmic-cyan font-bold">4. Open a Pull Request</span>
          <p class="text-text-muted">Our autonomous verification pipeline will inspect repository URLs, license tags, and download checksums before automated merge.</p>
        </div>
      </div>

      <div class="pt-4 border-t border-border-subtle flex items-center justify-between text-xs font-mono">
        <span class="text-text-muted">Turnaround: Automated review within 24 hours.</span>
        <a
          href="https://github.com/digi-ai"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cosmic-cyan hover:underline font-bold"
        >
          View GitHub Repository &rarr;
        </a>
      </div>
    </div>
  </PageContainer>
</BaseLayout>
