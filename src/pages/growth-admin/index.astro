---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import GlobalGrowthDashboard from '@/components/growth/GlobalGrowthDashboard';
---

<BaseLayout
  title="Global Growth & Search Authority Command Center — AI Satellite Admin"
  description="Secured administrative console for international search performance, technical SEO monitoring, topical authority, and developer adoption."
  noIndex={true}
>
  <PageContainer size="wide" class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Growth Admin' },
      ]}
    />

    <SectionHeading
      badge="Global Growth & Authority Console"
      title="International Search & Developer Adoption Engine"
      description="Real-time telemetry and management across Google Search Console, Bing Webmaster, technical SEO health, topical clusters, original research, referring domains, AEO/GEO, and developer conversion analytics."
    />

    <div class="mt-8">
      <GlobalGrowthDashboard client:load />
    </div>
  </PageContainer>
</BaseLayout>
