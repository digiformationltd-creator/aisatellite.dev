---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { solutionEngine } from '@/lib/solutions/solution-engine';
import { Terminal, CheckCircle2, AlertTriangle, ExternalLink } from 'lucide-react';

export async function getStaticPaths() {
  const solutions = solutionEngine.getAllSolutions();
  return solutions.map((sol) => ({
    params: { slug: sol.slug },
    props: { solution: sol },
  }));
}

const { solution } = Astro.props;
---

<BaseLayout
  title={`${solution.problem} — Developer Solution Blueprint`}
  description={solution.recommendedApproach}
>
  <PageContainer size="narrow" class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Solutions', href: '/solutions' },
        { label: solution.problem },
      ]}
    />

    <div class="my-6 space-y-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-cosmic-cyan/15 text-cosmic-cyan border border-cosmic-cyan/20">
          Difficulty: {solution.difficulty}
        </span>
        <span class="text-xs font-mono text-emerald-400 flex items-center gap-1">
          <CheckCircle2 className="w-3.5 h-3.5" />
          Verified: {solution.lastVerified}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-cosmic-white tracking-tight">
        {solution.problem}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
        {solution.recommendedApproach}
      </p>
    </div>

    <!-- Required Tooling Matrix -->
    <div class="my-8 p-5 rounded-2xl bg-space-900/60 backdrop-blur-xl border border-white/5 space-y-3">
      <h3 class="text-xs font-mono uppercase tracking-wider text-cosmic-cyan">
        Required Open-Source Tools
      </h3>
      <div class="flex flex-wrap gap-2">
        {solution.requiredTools.map((t) => (
          <a
            href={t.url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-space-950 border border-white/10 text-xs text-cosmic-white hover:border-cosmic-cyan flex items-center gap-1 transition-colors"
          >
            <span>{t.name}</span>
            <ExternalLink className="w-3 h-3 text-text-muted" />
          </a>
        ))}
      </div>
    </div>

    <!-- Step-by-Step Implementation Steps -->
    <div class="my-8 space-y-6">
      <h2 class="text-lg font-bold text-cosmic-white flex items-center gap-2">
        <Terminal className="w-5 h-5 text-cosmic-teal" />
        <span>Implementation Steps</span>
      </h2>

      <div class="space-y-4">
        {solution.implementationSteps.map((step) => (
          <div class="p-6 rounded-2xl bg-space-900/70 border border-white/5 space-y-3">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-cosmic-cyan/15 text-cosmic-cyan font-mono text-xs flex items-center justify-center font-bold">
                {step.step}
              </span>
              <h4 class="font-bold text-cosmic-white text-sm sm:text-base">
                {step.title}
              </h4>
            </div>

            <p class="text-xs sm:text-sm text-text-secondary">
              {step.description}
            </p>

            {step.codeSnippet && (
              <pre class="p-4 rounded-xl bg-space-950 border border-white/5 text-xs font-mono text-cosmic-white/90 overflow-x-auto">
                <code>{step.codeSnippet}</code>
              </pre>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Verification Checkpoints -->
    <div class="my-8 p-6 rounded-2xl bg-space-900/50 border border-emerald-500/20 space-y-3">
      <h3 class="text-sm font-bold text-emerald-400 flex items-center gap-2">
        <CheckCircle2 className="w-4 h-4" />
        <span>Verification Checklist</span>
      </h3>
      <ul class="space-y-1.5 text-xs text-text-secondary list-disc list-inside">
        {solution.verificationSteps.map((v) => (
          <li>{v}</li>
        ))}
      </ul>
    </div>

    <!-- Common Errors & Resolutions -->
    {solution.commonErrors.length > 0 && (
      <div class="my-8 p-6 rounded-2xl bg-space-900/50 border border-amber-500/20 space-y-3">
        <h3 class="text-sm font-bold text-amber-400 flex items-center gap-2">
          <AlertTriangle className="w-4 h-4" />
          <span>Troubleshooting Common Errors</span>
        </h3>
        <div class="space-y-3 text-xs">
          {solution.commonErrors.map((err) => (
            <div class="p-3 rounded-lg bg-space-950/80 border border-white/5 space-y-1">
              <span class="font-mono text-rose-400 block font-semibold">Error: {err.error}</span>
              <span class="text-text-muted block">Fix: {err.resolution}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Source Evidence Attributions -->
    <div class="my-8 pt-4 border-t border-white/5 flex flex-wrap items-center gap-3 text-xs text-text-muted">
      <span class="font-mono">Evidence Sources:</span>
      {solution.sources.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-cosmic-cyan hover:underline"
        >
          <span>{s.title}</span>
          <ExternalLink className="w-3 h-3" />
        </a>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
