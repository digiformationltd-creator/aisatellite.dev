---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import MyOrbitWorkspace from '@/components/workspace/MyOrbitWorkspace';
---

<BaseLayout
  title="My Orbit — Intelligent Personal Workspace | AI Satellite"
  description="Personal developer workspace for AI Satellite. Save verified tools, manage private prompts with versioning, store reusable code snippets, and track projects."
  noIndex={true}
>
  <PageContainer size="wide" class="py-10">
    <Breadcrumbs items={[{ label: 'My Orbit Workspace' }]} />

    <SectionHeading
      badge="Personal Orbit"
      title="My Orbit Workspace"
      description="Your personal, encrypted developer workstation. Save verified tools, craft versioned system prompts, store snippets, track projects, and master modern tech stacks."
    />

    <div class="my-8">
      <MyOrbitWorkspace client:load />
    </div>
  </PageContainer>
</BaseLayout>
