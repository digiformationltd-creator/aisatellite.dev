---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import AlternativeSearchEngine from '@/components/alternatives/AlternativeSearchEngine.tsx';
import type { AlternativeItem } from '@/lib/alternative-matching.ts';

const rawAlternatives = await getCollection('alternatives', ({ data }) => data.published);

// Map to typed AlternativeItem records
const alternatives: AlternativeItem[] = rawAlternatives.map((entry) => ({
  id: entry.id,
  slug: entry.id,
  title: entry.data.title,
  proprietaryTool: entry.data.proprietaryTool,
  openSourceReplacements: entry.data.openSourceReplacements,
  category: entry.data.category,
  summary: entry.data.summary,
  migrationGuidance: entry.data.migrationGuidance,
  replaces: entry.data.replaces || [entry.data.proprietaryTool],
  classification: entry.data.classification || ['open_source', 'self_hosted'],
  capabilities: entry.data.capabilities || [],
  limitations: entry.data.limitations || [],
  deploymentOptions: entry.data.deploymentOptions || ['Docker'],
  operatingSystems: entry.data.operatingSystems || ['Linux', 'macOS', 'Windows'],
  selfHosted: entry.data.selfHosted ?? true,
  freeHostedTier: entry.data.freeHostedTier ?? false,
  paidInfrastructureRequired: entry.data.paidInfrastructureRequired ?? false,
  verificationStatus: entry.data.verificationStatus || 'verified',
  evidenceUrls: entry.data.evidenceUrls || [],
  lastVerified: entry.data.lastVerified || '2026-10-31',
  partnerContext: entry.data.partnerContext || 'none',
}));
---

<BaseLayout
  title="Find a Free Alternative to Almost Anything — AI Satellite"
  description="Discover verified open-source software, free developer tools, self-hosted applications and practical alternatives to expensive subscriptions."
>
  <PageContainer class="py-12">
    <Breadcrumbs items={[{ label: 'Free Alternatives' }]} />

    {/* Hero Section */}
    <div class="text-center max-w-3xl mx-auto my-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cosmic-cyan/10 text-cosmic-cyan border border-cosmic-cyan/30 mb-4">
        <span>Software Freedom &bull; Zero Paywalls</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-text-primary tracking-tight leading-tight mb-4">
        Find a Free Alternative to <span class="text-transparent bg-clip-text bg-gradient-to-r from-cosmic-cyan via-cosmic-violet to-cosmic-emerald">Almost Anything.</span>
      </h1>

      <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto">
        Discover verified open-source software, free developer tools, self-hosted applications and practical alternatives to expensive subscriptions.
      </p>
    </div>

    {/* Interactive React Search Engine Island */}
    <AlternativeSearchEngine client:load initialItems={alternatives} />
  </PageContainer>
</BaseLayout>
