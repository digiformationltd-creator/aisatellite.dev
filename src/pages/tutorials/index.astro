---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { tutorialEngine } from '@/lib/tutorials/tutorial-engine';
import { ArrowRight, CheckCircle2 } from 'lucide-react';

const tutorials = tutorialEngine.getAllTutorials();
---

<BaseLayout
  title="Advanced Coding Tutorials & Engineering Blueprints — AI Satellite"
  description="Tested, production-grade coding tutorials across Three.js, WebGL, Astro, TypeScript, Cloudflare Workers, and autonomous AI agents."
>
  <PageContainer size="wide" class="py-10">
    <Breadcrumbs items={[{ label: 'Tutorials' }]} />

    <SectionHeading
      badge="Engineering Academy"
      title="Advanced Coding Tutorials"
      description="Production-grade implementation guides. Complete with prerequisites, runnable source code, troubleshooting matrices, and verified security practices."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      {tutorials.map((tut) => (
        <div class="p-6 rounded-2xl bg-space-900/60 backdrop-blur-xl border border-white/5 hover:border-cosmic-cyan/30 hover:shadow-orbital-glass transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-cosmic-cyan/15 text-cosmic-cyan border border-cosmic-cyan/20">
                {tut.category}
              </span>
              <span class="text-xs text-text-muted font-mono flex items-center gap-1">
                <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
                {tut.codeTested ? 'Tests Verified' : 'Draft'}
              </span>
            </div>

            <h3 class="text-lg font-bold text-cosmic-white tracking-wide">
              {tut.title}
            </h3>

            <p class="text-xs text-text-secondary leading-relaxed">
              {tut.problemStatement}
            </p>

            <div class="p-3 rounded-xl bg-space-950/60 border border-white/5 text-xs font-mono space-y-1">
              <span class="text-text-muted block">Language: <strong class="text-cosmic-cyan">{tut.language}</strong></span>
              <span class="text-text-muted block">Prerequisites: {tut.prerequisites.join(', ')}</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs text-text-muted font-mono">
              Verified {tut.lastVerified}
            </span>
            <a
              href={`/tutorials/${tut.slug}`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-cosmic-cyan hover:underline"
            >
              <span>Read Full Tutorial</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
