---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import CopyButton from '@/components/ui/CopyButton.tsx';
import { ExternalLink, Terminal, ShieldCheck, Cpu } from 'lucide-react';

const mcpServers = [
  {
    name: 'PostgreSQL MCP Server',
    description: 'Enables LLM agents to safely inspect schemas, run read-only queries, and explain SQL execution plans.',
    transport: 'stdio / docker',
    installCmd: 'npx -y @modelcontextprotocol/server-postgres postgresql://localhost/mydb',
    github: 'https://github.com/modelcontextprotocol/servers/tree/main/src/postgres',
    category: 'Databases',
  },
  {
    name: 'Filesystem MCP Server',
    description: 'Secure client-side file reading, directory listing, and surgical text edits with strict root-path sandboxing.',
    transport: 'stdio',
    installCmd: 'npx -y @modelcontextprotocol/server-filesystem /allowed/directory/path',
    github: 'https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem',
    category: 'Local Tools',
  },
  {
    name: 'GitHub MCP Server',
    description: 'Allows AI agents to search repositories, inspect pull request diffs, view commit logs, and manage issues via personal access token.',
    transport: 'stdio',
    installCmd: 'docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN mcp/github',
    github: 'https://github.com/modelcontextprotocol/servers/tree/main/src/github',
    category: 'DevOps',
  },
  {
    name: 'Puppeteer Web Automation MCP Server',
    description: 'Headless browser automation tool allowing AI agents to navigate pages, capture visual screenshots, and extract rendered DOM text.',
    transport: 'stdio',
    installCmd: 'npx -y @modelcontextprotocol/server-puppeteer',
    github: 'https://github.com/modelcontextprotocol/servers/tree/main/src/puppeteer',
    category: 'Browser',
  },
];
---

<BaseLayout
  title="Model Context Protocol (MCP) Server Catalog"
  description="Curated catalog of open-source MCP servers enabling Claude Code, Cursor, and autonomous agents to interact with local systems."
>
  <PageContainer class="py-10">
    <Breadcrumbs items={[{ label: 'MCP Servers' }]} />

    <SectionHeading
      badge="Open Protocol"
      title="Model Context Protocol (MCP) Servers"
      description="Connect your AI coding agents and LLMs to local databases, file systems, Git repositories, and browser runtimes using Anthropic's open standard."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      {
        mcpServers.map((server) => (
          <div class="cosmic-glass p-6 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <Badge variant="violet" size="sm">{server.category}</Badge>
                <span class="text-xs font-mono text-text-muted">Transport: {server.transport}</span>
              </div>

              <h2 class="text-xl font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
                {server.name}
              </h2>

              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                {server.description}
              </p>

              <!-- Install Snippet -->
              <div class="rounded-lg bg-space-950 p-3 border border-border-subtle font-mono text-xs text-cosmic-cyan flex items-center justify-between mb-4 overflow-x-auto">
                <code class="truncate mr-2">{server.installCmd}</code>
                <CopyButton client:visible text={server.installCmd} label="Copy" />
              </div>
            </div>

            <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
              <span class="text-xs font-mono text-cosmic-emerald flex items-center gap-1">
                <ShieldCheck className="w-3.5 h-3.5" />
                Vetted Open Source
              </span>
              <a
                href={server.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-cosmic-cyan hover:underline inline-flex items-center gap-1"
              >
                <span>GitHub Source</span>
                <ExternalLink className="w-3 h-3" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </PageContainer>
</BaseLayout>
