---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { troubleshootingEngine } from '@/lib/knowledge/troubleshooting-engine';
import { Wrench, ArrowRight, ShieldCheck, AlertCircle } from 'lucide-react';

const solutions = troubleshootingEngine.getAllSolutions();
---

<BaseLayout
  title="Developer Troubleshooting Universe — AI Satellite"
  description="Structured problem-solving guides for build failures, WebGL crashes, React hydration mismatches, and Cloudflare deployment errors."
>
  <PageContainer size="wide" class="py-10 space-y-10">
    <Breadcrumbs items={[{ label: 'Troubleshooting Universe', href: '/troubleshooting' }]} />

    <SectionHeading
      badge="Diagnostic & Resolution Hub"
      title="Developer Troubleshooting Universe"
      description="Evidence-backed diagnostics, symptoms, root-cause analyses, and verified code fixes across modern web frameworks and cloud infrastructure."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {solutions.map((sol) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 backdrop-blur-xl border border-white/10 hover:border-cyan-500/30 transition-all flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/20 uppercase">
                {sol.tags[0]}
              </span>
              <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                <ShieldCheck className="w-3 h-3" />
                Verified {sol.lastVerifiedDate}
              </span>
            </div>

            <h3 class="text-base font-bold text-white tracking-wide hover:text-cyan-300 transition-colors">
              <a href={`/troubleshooting/${sol.slug}`}>
                {sol.title}
              </a>
            </h3>

            <p class="text-xs text-slate-300 leading-relaxed line-clamp-3">
              {sol.summary}
            </p>

            <div class="pt-2">
              <div class="text-[11px] font-mono text-slate-400 mb-1">Key Symptoms:</div>
              <ul class="text-[11px] text-slate-400 space-y-1 list-disc list-inside">
                {sol.symptoms.slice(0, 2).map((sym) => (
                  <li class="truncate">{sym}</li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <span class="text-[11px] font-mono text-cyan-400">
              {sol.verifiedFixes.length} Verified Fix{sol.verifiedFixes.length > 1 ? 'es' : ''}
            </span>
            <a
              href={`/troubleshooting/${sol.slug}`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-300 hover:text-white transition-colors"
            >
              View Diagnostics <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
