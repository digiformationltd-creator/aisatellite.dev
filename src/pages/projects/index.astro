---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import { Download, ExternalLink, ShieldCheck, Terminal, ArrowRight, Sparkles, Box } from 'lucide-react';

const projects = await getCollection('projects', ({ data }) => data.published);
---

<BaseLayout
  title="Original Open-Source Software Distribution Hub — AI Satellite"
  description="Explore, inspect, and download sovereign, privacy-first software suites, autonomous agent frameworks, and developer tools built with zero vendor lock-in."
>
  <PageContainer class="py-10 max-w-6xl">
    <Breadcrumbs items={[{ label: 'Open-Source Projects' }]} />

    <SectionHeading
      badge="Original Open-Source Engineering"
      title="Sovereign Software & Autonomous Tools Hub"
      description="Production-grade desktop applications, autonomous agent frameworks, and developer intelligence suites built for self-hosting, privacy, and full data ownership."
    />

    <!-- Quick Navigation Bar -->
    <div class="flex items-center gap-3 flex-wrap justify-center my-6">
      <a
        href="/downloads"
        class="px-4 py-2 rounded-full text-xs font-mono bg-cosmic-cyan text-space-950 font-bold shadow-glow-cyan/20 flex items-center gap-1.5"
      >
        <Download className="w-3.5 h-3.5" />
        <span>Central Downloads Hub</span>
      </a>
      <a
        href="/new-releases"
        class="px-4 py-2 rounded-full text-xs font-mono bg-space-900 hover:bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle transition-colors flex items-center gap-1.5"
      >
        <Sparkles className="w-3.5 h-3.5" />
        <span>New Releases</span>
      </a>
      <a
        href="/submit-project"
        class="px-4 py-2 rounded-full text-xs font-mono bg-space-900 hover:bg-space-850 text-text-secondary hover:text-cosmic-cyan border border-border-subtle transition-colors flex items-center gap-1.5"
      >
        <Box className="w-3.5 h-3.5" />
        <span>Submit a Project</span>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {projects.map((project) => (
        <div class="cosmic-glass p-6 rounded-card border border-border-subtle hover:border-cosmic-cyan/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <Badge variant="violet" size="sm">{project.data.family}</Badge>
              <span class="text-[11px] font-mono text-cosmic-emerald flex items-center gap-1">
                <ShieldCheck className="w-3 h-3" />
                <span>v{project.data.version}</span>
              </span>
            </div>

            <h3 class="text-xl font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-1">
              <a href={`/projects/${project.id}`}>{project.data.title}</a>
            </h3>

            <p class="text-xs font-mono text-cosmic-cyan/80 mb-3">{project.data.tagline}</p>

            <p class="text-xs text-text-secondary leading-relaxed mb-4 line-clamp-3">
              {project.data.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {project.data.techStack.map((tech) => (
                <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-space-950 text-text-muted border border-border-subtle">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
            <span class="text-[11px] font-mono text-text-muted">{project.data.openSourceLicense}</span>
            <div class="flex items-center gap-2">
              <a
                href={`/projects/${project.id}/releases`}
                class="text-xs font-semibold text-cosmic-cyan hover:underline inline-flex items-center gap-1"
              >
                <span>Releases</span>
                <ArrowRight className="w-3 h-3" />
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
