---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import { Check, X, ShieldCheck } from 'lucide-react';

export async function getStaticPaths() {
  const comparisons = [
    {
      slug: 'postgresql-vs-sqlite',
      title: 'PostgreSQL vs. SQLite: Architectural Deep-Dive',
      description: 'Comparing client-server enterprise object-relational databases against ultra-fast embedded single-file storage.',
      itemA: {
        name: 'PostgreSQL',
        type: 'Client-Server RDBMS',
        license: 'PostgreSQL License',
        cost: '100% Free Self-Hosted',
        bestFor: 'High concurrency, multi-user web applications, microservices, complex analytical queries.',
        features: ['Full ACID MVCC', 'Native JSONB & PostGIS', 'Connection Pooling required', 'Server Process'],
      },
      itemB: {
        name: 'SQLite',
        type: 'Serverless Embedded DB',
        license: 'Public Domain',
        cost: '100% Free Everywhere',
        bestFor: 'Mobile apps, desktop software, embedded edge workers (D1), local read-heavy caches.',
        features: ['Zero Configuration', 'Single File storage', 'Single-writer concurrency', 'No Network latency'],
      },
      verdict: 'Use PostgreSQL when multiple servers write concurrently; choose SQLite for edge runtimes, mobile devices, or read-heavy single-node architectures.',
    },
    {
      slug: 'minio-vs-aws-s3',
      title: 'MinIO vs. Amazon S3: Cost & Egress Comparison',
      description: 'Evaluating self-hosted S3-compatible object storage against Amazon AWS S3 public cloud storage.',
      itemA: {
        name: 'MinIO Object Store',
        type: 'Self-Hosted S3 Protocol',
        license: 'AGPL-3.0',
        cost: '$0 Egress Fees',
        bestFor: 'AI model storage, video streaming pipelines, private cloud infrastructure.',
        features: ['S3 v4 Compatible', 'High NVMe Throughput', 'Runs on your hardware', 'Zero data transfer fees'],
      },
      itemB: {
        name: 'Amazon AWS S3',
        type: 'Managed Cloud Storage',
        license: 'Proprietary Cloud',
        cost: 'Storage + High Egress Fees',
        bestFor: 'Turnkey enterprise setups with large compliance teams and existing AWS ecosystems.',
        features: ['99.999999999% Durability', 'Managed infrastructure', 'Per-request pricing', 'Steep egress costs'],
      },
      verdict: 'MinIO eliminates the painful egress bandwidth fees of AWS S3 while maintaining 100% API compatibility with existing SDKs.',
    },
    {
      slug: 'supabase-vs-firebase',
      title: 'Supabase vs. Google Firebase: SQL vs. NoSQL',
      description: 'Why modern engineering teams are choosing relational Postgres over proprietary NoSQL collections.',
      itemA: {
        name: 'Supabase',
        type: 'Open-Source Relational BaaS',
        license: 'Apache 2.0',
        cost: 'Generous Free Tier + Self-Hosted',
        bestFor: 'Modern full-stack apps needing structured relational data, SQL joins, and self-hosting flexibility.',
        features: ['Full PostgreSQL Engine', 'Row Level Security', 'Self-hostable via Docker', 'Auto-generated APIs'],
      },
      itemB: {
        name: 'Google Firebase',
        type: 'Proprietary Cloud BaaS',
        license: 'Proprietary',
        cost: 'Pay-per-document-read',
        bestFor: 'Rapid mobile prototyping with simple key-value structures where vendor lock-in is not a concern.',
        features: ['Firestore NoSQL', 'Integrated Google Auth', 'Unpredictable scaling fees', 'No self-hosting'],
      },
      verdict: 'Supabase provides standard SQL freedom, relational data integrity, and complete self-hosting sovereignty.',
    },
  ];

  return comparisons.map((comp) => ({
    params: { slug: comp.slug },
    props: { comp },
  }));
}

const { comp } = Astro.props;
---

<BaseLayout
  title={`${comp.title} — AI Satellite`}
  description={comp.description}
>
  <PageContainer size="narrow" class="py-10">
    <Breadcrumbs
      items={[
        { label: 'Alternatives', href: '/alternatives' },
        { label: comp.title },
      ]}
    />

    <header class="mt-6 pb-6 border-b border-border-subtle">
      <Badge variant="cyan" class="mb-3">Architectural Comparison</Badge>
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-text-primary tracking-tight">
        {comp.title}
      </h1>
      <p class="mt-3 text-base text-text-secondary leading-relaxed">
        {comp.description}
      </p>
    </header>

    <!-- Side-by-Side Comparison Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <!-- Item A -->
      <div class="cosmic-glass p-6 border-cosmic-cyan/40">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-2xl font-heading font-bold text-cosmic-cyan">{comp.itemA.name}</h2>
          <Badge variant="cyan">{comp.itemA.type}</Badge>
        </div>
        <div class="text-xs font-mono text-cosmic-emerald mb-4 font-semibold">{comp.itemA.cost}</div>
        <p class="text-sm text-text-secondary mb-6">{comp.itemA.bestFor}</p>

        <h3 class="text-xs font-mono font-bold text-text-primary uppercase tracking-wider mb-3">Key Attributes</h3>
        <ul class="space-y-2 text-xs font-mono text-text-secondary">
          {comp.itemA.features.map((feat) => (
            <li class="flex items-center gap-2">
              <Check className="w-4 h-4 text-cosmic-emerald" />
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Item B -->
      <div class="cosmic-glass p-6 border-border-subtle">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-2xl font-heading font-bold text-text-primary">{comp.itemB.name}</h2>
          <Badge variant="subtle">{comp.itemB.type}</Badge>
        </div>
        <div class="text-xs font-mono text-text-muted mb-4 font-semibold">{comp.itemB.cost}</div>
        <p class="text-sm text-text-secondary mb-6">{comp.itemB.bestFor}</p>

        <h3 class="text-xs font-mono font-bold text-text-primary uppercase tracking-wider mb-3">Key Attributes</h3>
        <ul class="space-y-2 text-xs font-mono text-text-secondary">
          {comp.itemB.features.map((feat) => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-text-muted"></span>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Editorial Verdict -->
    <div class="p-6 rounded-card bg-space-900 border border-cosmic-cyan/30 my-8">
      <h3 class="text-base font-heading font-bold text-cosmic-cyan mb-2 flex items-center gap-2">
        <ShieldCheck className="w-5 h-5 text-cosmic-cyan" />
        <span>Technical Verdict & Guidance</span>
      </h3>
      <p class="text-sm text-text-primary leading-relaxed">
        {comp.verdict}
      </p>
    </div>

    <div class="mt-12 pt-8 border-t border-border-subtle text-center">
      <a href="/alternatives" class="text-sm font-mono text-cosmic-cyan hover:underline">
        &larr; Return to All Alternatives
      </a>
    </div>
  </PageContainer>
</BaseLayout>
