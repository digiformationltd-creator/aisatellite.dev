---
import { Search, Sparkles, Terminal, ArrowRight, ShieldCheck, Activity, Radio, Cpu } from 'lucide-react';
import PageContainer from '@/components/layout/PageContainer.astro';
import Button from '@/components/ui/Button.astro';

const suggestedSearches = [
  { label: 'Free AI Coding', query: 'Ollama' },
  { label: 'Open-Source CRM', query: 'CRM' },
  { label: 'Free Hosting', query: 'Cloudflare Pages' },
  { label: 'Three.js', query: 'Three.js' },
  { label: 'MCP Servers', query: 'MCP' },
  { label: 'AI Automation', query: 'Workflows' },
];
---

<section class="relative pt-12 pb-24 md:pt-20 md:pb-36 overflow-hidden">
  <!-- Three.js Cinematic Space Canvas Container (Background) -->
  <div
    id="cosmic-hero-canvas-container"
    class="absolute inset-0 z-0 pointer-events-none opacity-85"
    aria-hidden="true"
  >
    <!-- CSS Fallback Background -->
    <div class="absolute inset-0 bg-radial-gradient from-cosmic-blue/10 via-space-950 to-space-950"></div>
  </div>

  <PageContainer class="relative z-10 text-center">
    <!-- Top Telemetry & Station Status Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-medium glass-pill text-cosmic-cyan mb-8 shadow-glow-cyan/20">
      <span class="w-2 h-2 rounded-full bg-cosmic-cyan animate-pulse"></span>
      <span class="tracking-wide">AI SATELLITE STATION &bull; ORBIT ALTITUDE 418 KM &bull; 100% OPERATIONAL</span>
    </div>

    <!-- Main Cinematic Heading -->
    <div class="mb-4">
      <span class="text-xs sm:text-sm font-mono tracking-[0.28em] text-cosmic-cyan/90 uppercase font-bold">
        The Global Autonomous Knowledge Station
      </span>
    </div>

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black text-text-primary tracking-tight max-w-5xl mx-auto leading-[1.08] glow-text-cyan">
      AI SATELLITE
    </h1>

    <!-- Flagship Tagline -->
    <p class="mt-4 text-xl sm:text-2xl md:text-3xl font-heading font-semibold gradient-text-orbital max-w-3xl mx-auto leading-tight">
      Explore the Free Universe of AI, Open Source & Development.
    </p>

    <!-- Supporting Narrative -->
    <p class="mt-6 text-base sm:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed font-sans font-normal">
      Direct telemetry to verified free developer tools, production-ready AI prompts, autonomous multi-agent playbooks, interactive 3D WebGL components, and open-source software factory releases.
    </p>

    <!-- Floating Telemetry Glass Badges (Desktop) -->
    <div class="hidden lg:flex items-center justify-center gap-6 mt-8">
      <div class="px-4 py-2 glass-pill text-xs font-mono text-text-muted flex items-center gap-2">
        <Radio className="w-3.5 h-3.5 text-cosmic-cyan" />
        <span>Telemetry: Active Stream</span>
      </div>
      <div class="px-4 py-2 glass-pill text-xs font-mono text-text-muted flex items-center gap-2">
        <Cpu className="w-3.5 h-3.5 text-cosmic-purple" />
        <span>Nodes: 163 Verified Repos</span>
      </div>
      <div class="px-4 py-2 glass-pill text-xs font-mono text-text-muted flex items-center gap-2">
        <ShieldCheck className="w-3.5 h-3.5 text-cosmic-emerald" />
        <span>Edge: Zero Paywalls</span>
      </div>
    </div>

    <!-- Prominent Working Liquid Glass Search Bar -->
    <div class="mt-10 max-w-2xl mx-auto">
      <div
        class="relative flex items-center p-2.5 rounded-2xl glass-search transition-all duration-300 group cursor-pointer"
        onclick="window.dispatchEvent(new CustomEvent('open-search'))"
      >
        <div class="pl-3 pr-2 text-cosmic-cyan">
          <Search className="w-5 h-5 group-hover:scale-110 transition-transform" />
        </div>
        <input
          type="text"
          readonly
          placeholder="Search 1,000s of tools, prompts, workflows & free alternatives..."
          class="w-full bg-transparent text-sm sm:text-base text-text-primary placeholder:text-text-muted focus:outline-none cursor-pointer py-1.5 font-sans"
          aria-label="Click to search across tools, prompts, and playbooks"
        />
        <div class="pr-2 flex items-center gap-1.5">
          <kbd class="hidden sm:inline-block px-2.5 py-1 text-xs font-mono font-semibold text-text-muted bg-space-950/80 rounded-lg border border-border-subtle shadow-inner">
            ⌘K / Ctrl+K
          </kbd>
        </div>
      </div>

      <!-- Suggested Searches -->
      <div class="mt-4 flex items-center justify-center gap-2 flex-wrap text-xs font-mono text-text-muted">
        <span class="text-text-muted/70">Popular:</span>
        {
          suggestedSearches.map((item) => (
            <button
              type="button"
              class="hover:text-cosmic-cyan hover:underline transition-colors px-2 py-0.5 glass-pill border-opacity-40"
              onclick="window.dispatchEvent(new CustomEvent('open-search'))"
            >
              {item.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Primary Action Buttons with Liquid Glass Styling -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/open-source" variant="primary" size="lg">
        <span>Explore Free Tools</span>
        <ArrowRight className="w-4 h-4" />
      </Button>

      <Button href="/ai-agents" variant="secondary" size="lg">
        <Sparkles className="w-4 h-4 text-cosmic-purple" />
        <span>Discover AI Workflows</span>
      </Button>

      <Button href="/3d-lab" variant="outline" size="lg">
        <Activity className="w-4 h-4 text-cosmic-cyan" />
        <span>3D Web Lab</span>
      </Button>
    </div>
  </PageContainer>
</section>

<!-- Client script to dynamically initialize Three.js canvas safely -->
<script>
  if (typeof window !== 'undefined') {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      import('./CosmicCanvas.client').then(({ initCosmicCanvas }) => {
        initCosmicCanvas('cosmic-hero-canvas-container');
      });
    }
  }
</script>
