---
import { ExternalLink, Star, ShieldCheck, ArrowRight } from 'lucide-react';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  tool: {
    id: string;
    data: {
      name: string;
      description: string;
      category: string;
      tags: string[];
      officialUrl: string;
      repositoryUrl?: string;
      license?: string;
      pricingModel: string;
      selfHosted: boolean;
      githubStars?: number;
      verificationStatus: string;
      lastVerified: string;
      featured?: boolean;
    };
  };
  class?: string;
}

const { tool, class: className = '' } = Astro.props;
const { name, description, category, tags, officialUrl, repositoryUrl, license, pricingModel, selfHosted, verificationStatus } = tool.data;
---

<article
  class:list={[
    'cosmic-glass p-5 flex flex-col justify-between group transition-all duration-200 h-full',
    className,
  ]}
>
  <div>
    <!-- Header with Category and Verification -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <Badge variant="subtle" size="sm">{category}</Badge>
      <div class="flex items-center gap-1.5">
        {selfHosted && (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-space-850 text-cosmic-emerald border border-cosmic-emerald/20">
            Self-Hosted
          </span>
        )}
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-space-850 text-cosmic-cyan border border-cosmic-cyan/20 uppercase">
          {pricingModel}
        </span>
      </div>
    </div>

    <!-- Title & Links -->
    <h3 class="text-xl font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-2">
      <a href={`/tools/${tool.id}`} class="focus:outline-none focus:underline">
        {name}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-text-secondary leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.slice(0, 3).map((tag) => (
        <span class="text-xs font-mono text-text-muted bg-space-950/60 px-2 py-0.5 rounded border border-border-subtle">
          #{tag}
        </span>
      ))}
      {license && (
        <span class="text-xs font-mono text-cosmic-violet bg-space-950/60 px-2 py-0.5 rounded border border-cosmic-violet/20">
          {license}
        </span>
      )}
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
    <a
      href={`/tools/${tool.id}`}
      class="text-xs font-medium text-text-secondary hover:text-cosmic-cyan flex items-center gap-1 transition-colors"
    >
      <span>Full Specs</span>
      <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
    </a>

    <div class="flex items-center gap-2">
      {repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-text-muted hover:text-text-primary p-1.5 rounded hover:bg-space-850 transition-colors"
          aria-label={`GitHub Repository for ${name}`}
        >
          <ExternalLink className="w-3.5 h-3.5" />
        </a>
      )}
      <a
        href={officialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-cosmic-cyan hover:underline inline-flex items-center gap-1"
      >
        <span>Site</span>
        <ExternalLink className="w-3 h-3" />
      </a>
    </div>
  </div>
</article>
