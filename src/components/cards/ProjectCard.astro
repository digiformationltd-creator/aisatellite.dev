---
import { ExternalLink, Terminal, ArrowRight, ShieldCheck } from 'lucide-react';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      tagline: string;
      family: string;
      description: string;
      techStack: string[];
      openSourceLicense: string;
      repositoryUrl?: string;
      documentationUrl?: string;
      verificationStatus: string;
      features: string[];
    };
  };
  class?: string;
}

const { project, class: className = '' } = Astro.props;
const { title, tagline, family, description, techStack, openSourceLicense, repositoryUrl } = project.data;
---

<article class:list={['cosmic-glass p-6 flex flex-col justify-between group h-full relative overflow-hidden', className]}>
  <div class="absolute top-0 right-0 w-32 h-32 bg-cosmic-violet/5 rounded-full blur-2xl group-hover:bg-cosmic-violet/10 pointer-events-none"></div>

  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <Badge variant="violet" size="sm">{family}</Badge>
      <span class="text-xs font-mono text-cosmic-emerald flex items-center gap-1">
        <ShieldCheck className="w-3.5 h-3.5" />
        Verified Project
      </span>
    </div>

    <h3 class="text-xl font-heading font-bold text-text-primary group-hover:text-cosmic-violet transition-colors mb-1">
      <a href={`/projects/${project.id}`}>
        {title}
      </a>
    </h3>

    <p class="text-xs font-mono text-cosmic-cyan mb-3">{tagline}</p>

    <p class="text-sm text-text-secondary leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>

    <!-- Tech Stack -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {techStack.map((tech) => (
        <span class="text-xs font-mono text-text-muted bg-space-950 px-2 py-0.5 rounded border border-border-subtle">
          {tech}
        </span>
      ))}
    </div>
  </div>

  <div class="pt-4 border-t border-border-subtle flex items-center justify-between mt-auto">
    <a
      href={`/projects/${project.id}`}
      class="text-xs font-semibold text-text-primary hover:text-cosmic-violet inline-flex items-center gap-1"
    >
      <span>Explore Software Architecture</span>
      <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
    </a>
    {repositoryUrl && (
      <a
        href={repositoryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-text-muted hover:text-text-primary flex items-center gap-1"
      >
        <span>Repo</span>
        <ExternalLink className="w-3 h-3" />
      </a>
    )}
  </div>
</article>
