---
import { CheckSquare, ArrowRight } from 'lucide-react';

interface Props {
  items: string[];
  title?: string;
  class?: string;
}

const {
  items,
  title = 'Practical Implementation Checklist',
  class: className = '',
} = Astro.props;

if (!items || items.length === 0) return null;
---

<div
  class:list={[
    'my-8 p-6 rounded-card bg-space-900 border border-border-subtle shadow-orbital-glass',
    className,
  ]}
  aria-label={title}
>
  <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border-subtle">
    <CheckSquare className="w-5 h-5 text-cosmic-cyan" />
    <h3 class="text-base sm:text-lg font-heading font-bold text-text-primary">
      {title}
    </h3>
  </div>

  <ul class="space-y-3">
    {
      items.map((item, idx) => (
        <li class="flex items-start gap-3 text-sm text-text-secondary leading-relaxed group">
          <span class="w-5 h-5 rounded border border-cosmic-cyan/40 bg-space-850 flex items-center justify-center text-xs font-mono text-cosmic-cyan flex-shrink-0 mt-0.5 group-hover:border-cosmic-cyan group-hover:bg-cosmic-cyan/10 transition-colors">
            {idx + 1}
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</div>
