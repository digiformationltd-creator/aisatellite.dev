---
import { Info, ShieldCheck } from 'lucide-react';

interface Props {
  class?: string;
  hasCommercialContent?: boolean;
}

const { class: className = '', hasCommercialContent = true } = Astro.props;
---

<div
  class:list={[
    'p-4 sm:p-5 rounded-card bg-space-900/90 border border-border-subtle text-xs text-text-muted flex items-start gap-3 my-8',
    className,
  ]}
  role="note"
  aria-label="Editorial and Commercial Disclosure"
>
  <Info className="w-4 h-4 text-cosmic-cyan flex-shrink-0 mt-0.5" />
  <div class="space-y-1.5 leading-relaxed">
    <div class="flex items-center gap-2">
      <strong class="text-text-primary font-semibold">Editorial Independence &amp; Commercial Disclosure:</strong>
      <span class="inline-flex items-center text-[10px] font-mono px-2 py-0.5 rounded bg-space-800 text-cosmic-cyan border border-cosmic-cyan/30">
        <ShieldCheck className="w-3 h-3 mr-1 inline" />
        Verified Standard
      </span>
    </div>
    <p class="text-text-secondary">
      AI Satellite is an independent global technology and business knowledge publication. When our guides evaluate operational challenges, we may contextually reference vetted commercial platforms—specifically <strong>DigiFormation</strong> (for corporate incorporation and legal compliance) and <strong>Digi Biz OS</strong> (for integrated business management)—with whom we maintain commercial affiliations.
    </p>
    <p class="text-[11px] text-text-muted">
      We never accept payment to falsely praise software, manipulate tool rankings, or disguise advertisements as editorial citations. All recommendations are verified for relevance, security, and real utility.
    </p>
  </div>
</div>
