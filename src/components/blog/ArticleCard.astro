---
import Badge from '@/components/ui/Badge.astro';
import { Clock, Calendar, ArrowRight, User } from 'lucide-react';
import type { ArticleModel } from '@/lib/blog/types';

interface Props {
  article: ArticleModel;
  featured?: boolean;
  class?: string;
}

const { article, featured = false, class: className = '' } = Astro.props;

const authorName =
  typeof article.author === 'string' ? article.author : article.author.name;

const categorySlug = article.primaryCategory
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  class:list={[
    'group rounded-card bg-space-900/80 border border-border-subtle hover:border-cosmic-cyan/50 transition-all duration-200 overflow-hidden flex flex-col justify-between hover:shadow-orbital-glass',
    featured ? 'p-6 sm:p-8 border-cosmic-cyan/30 bg-gradient-to-br from-space-900 to-space-850' : 'p-5 sm:p-6',
    className,
  ]}
>
  <div>
    <!-- Top Metadata Header -->
    <div class="flex items-center justify-between gap-3 mb-3">
      <a
        href={`/blog/category/${categorySlug}`}
        class="inline-block hover:opacity-85 transition-opacity"
      >
        <Badge variant={featured ? 'cyan' : 'subtle'} size="sm">
          {article.primaryCategory}
        </Badge>
      </a>

      <div class="flex items-center gap-3 text-xs font-mono text-text-muted">
        <span class="inline-flex items-center gap-1">
          <Clock className="w-3 h-3 text-cosmic-cyan" />
          {article.readingTime}
        </span>
        <span class="inline-flex items-center gap-1">
          <Calendar className="w-3 h-3" />
          {formattedDate}
        </span>
      </div>
    </div>

    <!-- Article Title -->
    <h3
      class:list={[
        'font-heading font-bold text-text-primary group-hover:text-cosmic-cyan transition-colors mb-3 leading-snug',
        featured ? 'text-xl sm:text-2xl' : 'text-lg sm:text-xl',
      ]}
    >
      <a href={`/blog/${article.slug}`} class="focus:outline-none focus:underline">
        {article.title}
      </a>
    </h3>

    <!-- Summary / Description -->
    <p class="text-sm text-text-secondary leading-relaxed mb-4 line-clamp-3">
      {article.description}
    </p>
  </div>

  <!-- Footer: Tags, Author & Read Link -->
  <div class="pt-4 border-t border-border-subtle/60 mt-auto">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-xs text-text-muted truncate">
        <div class="w-5 h-5 rounded-full bg-space-800 border border-cosmic-cyan/30 flex items-center justify-center flex-shrink-0 text-[10px] text-cosmic-cyan">
          <User className="w-3 h-3" />
        </div>
        <span class="truncate">{authorName}</span>
      </div>

      <a
        href={`/blog/${article.slug}`}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-cosmic-cyan hover:text-cosmic-teal transition-colors flex-shrink-0"
        aria-label={`Read article: ${article.title}`}
      >
        <span>Read Guide</span>
        <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</article>
