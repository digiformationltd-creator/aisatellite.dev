---
import { ExternalLink, ShieldCheck, BookOpen } from 'lucide-react';
import type { SourceReference } from '@/lib/blog/types';

interface Props {
  sources: SourceReference[];
  class?: string;
}

const { sources = [], class: className = '' } = Astro.props;

if (sources.length === 0) return null;
---

<section
  class:list={[
    'my-10 p-6 rounded-card bg-space-950 border border-border-subtle/80',
    className,
  ]}
  aria-label="Verified Source References and Research Evidence"
>
  <div class="flex items-center gap-2 mb-4 pb-3 border-b border-border-subtle/60">
    <BookOpen className="w-4 h-4 text-cosmic-cyan" />
    <h3 class="text-sm font-mono font-bold text-text-primary uppercase tracking-wider">
      Verified Research Sources &amp; Empirical Evidence
    </h3>
  </div>

  <div class="space-y-3">
    {
      sources.map((src) => (
        <div class="p-3.5 rounded-lg bg-space-900/60 border border-border-subtle/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-semibold text-text-primary">{src.title}</span>
              <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-full bg-cosmic-teal/10 text-cosmic-teal border border-cosmic-teal/20">
                <ShieldCheck className="w-3 h-3" />
                {src.confidence || 'Verified'}
              </span>
            </div>
            {src.claim && (
              <p class="text-text-muted mt-1 italic">
                &ldquo;{src.claim}&rdquo;
              </p>
            )}
          </div>

          <a
            href={src.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-cosmic-cyan hover:underline flex-shrink-0 font-medium"
          >
            <span>Primary Source</span>
            <ExternalLink className="w-3 h-3" />
          </a>
        </div>
      ))
    }
  </div>
</section>
