---
import { Search, PlusCircle } from 'lucide-react';
import GithubIcon from '@/components/icons/GithubIcon.astro';
import DesktopMegaMenu from '@/components/navigation/DesktopMegaMenu.tsx';
import MobileNavigation from '@/components/navigation/MobileNavigation.tsx';
import PageContainer from '@/components/layout/PageContainer.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/radar', label: 'Radar' },
  { href: '/alternatives', label: 'Alternatives' },
  { href: '/solutions', label: 'Solutions' },
  { href: '/tutorials', label: 'Tutorials' },
  { href: '/components', label: 'Components' },
  { href: '/prompts/builder', label: 'Prompts' },
  { href: '/3d-lab', label: '3D Web Lab' },
  { href: '/projects', label: 'Software Hub' },
  { href: '/community', label: 'Community' },
  { href: '/workspace', label: 'Workspace' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-cosmic-cyan/15 bg-space-950/70 backdrop-blur-2xl transition-all duration-300 shadow-orbital-glass">
  <PageContainer>
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-cosmic-cyan rounded-xl p-1.5 transition">
        <div class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-space-900/90 border border-cosmic-cyan/30 flex items-center justify-center overflow-hidden shadow-glow-cyan/20 group-hover:border-cosmic-cyan transition-all group-hover:scale-105">
          <!-- Orbital Satellite Vector Mark -->
          <svg class="w-6 h-6 text-cosmic-cyan transition-transform duration-500 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" opacity="0.3"/>
            <circle cx="12" cy="12" r="3" fill="#56e5ff" stroke="none" />
            <ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(-30 12 12)" stroke="#9875ff" stroke-dasharray="2 2" />
          </svg>
        </div>
        <div>
          <span class="font-heading font-black text-lg sm:text-xl text-text-primary tracking-tight group-hover:text-cosmic-cyan transition-colors">
            AI Satellite
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-cosmic-cyan/70 tracking-widest uppercase">
            Orbital Knowledge
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
        <DesktopMegaMenu client:load />

        {
          navLinks.map((link) => {
            const isActive = currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'text-sm font-medium transition-colors py-1 relative',
                  isActive
                    ? 'text-cosmic-cyan font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-cosmic-cyan after:rounded-full after:shadow-glow-cyan/50'
                    : 'text-text-secondary hover:text-text-primary',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Search Trigger Button -->
        <button
          type="button"
          id="global-search-trigger"
          class="flex items-center gap-2 px-3.5 py-1.5 rounded-button bg-space-900/80 hover:bg-space-850 text-text-muted hover:text-cosmic-cyan border border-cosmic-cyan/20 hover:border-cosmic-cyan/50 transition-all text-xs font-mono shadow-sm"
          aria-label="Open search dialog"
          onclick="window.dispatchEvent(new CustomEvent('open-search'))"
        >
          <Search className="w-3.5 h-3.5" />
          <span class="hidden lg:inline text-text-secondary">Search...</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-space-950 text-text-muted rounded border border-border-subtle shadow-inner">
            ⌘K
          </kbd>
        </button>

        <!-- GitHub Repo Shortcut -->
        <a
          href="https://github.com/ripienaar/free-for-dev"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-button bg-space-900/80 hover:bg-space-850 text-text-secondary hover:text-text-primary border border-cosmic-cyan/20 transition-all hover:scale-105"
          aria-label="View Open-Source Data on GitHub"
        >
          <GithubIcon class="w-4 h-4" />
        </a>

        <!-- Submit Tool / Contribute Link -->
        <a
          href="/contribute"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-button bg-cosmic-cyan/10 hover:bg-cosmic-cyan/20 text-cosmic-cyan border border-cosmic-cyan/30 text-xs font-semibold transition-all hover:shadow-glow-cyan/30 hover:scale-105"
        >
          <PlusCircle className="w-3.5 h-3.5" />
          <span>Contribute</span>
        </a>

        <!-- Mobile Navigation Menu Toggle Island -->
        <MobileNavigation client:media="(max-width: 768px)" />
      </div>
    </div>
  </PageContainer>
</header>
