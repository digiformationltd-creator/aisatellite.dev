---
interface Props {
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
}

const { class: className = '', size = 'default' } = Astro.props;

const sizeStyles = {
  narrow: 'max-w-4xl',
  default: 'max-w-7xl',
  wide: 'max-w-[1440px]',
};
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', sizeStyles[size], className]}>
  <slot />
</div>
