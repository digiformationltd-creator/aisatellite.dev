---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  badge,
  title,
  description,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div class:list={['mb-8 md:mb-12', align === 'center' ? 'text-center' : 'text-left', className]}>
  {badge && (
    <div class:list={['inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-space-850 text-cosmic-cyan border border-cosmic-cyan/30 mb-3', align === 'center' ? 'mx-auto' : '']}>
      <span class="w-1.5 h-1.5 rounded-full bg-cosmic-cyan animate-pulse"></span>
      {badge}
    </div>
  )}
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-text-primary tracking-tight">
    {title}
  </h2>
  {description && (
    <p class="mt-3 text-base sm:text-lg text-text-secondary max-w-3xl leading-relaxed">
      {description}
    </p>
  )}
</div>
